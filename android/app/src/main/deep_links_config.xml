<!-- ======================== -->
<!-- ملاحظات مهمة             -->
<!-- ======================== -->

<!--
1. android:autoVerify="true" 
   - يجعل Android يتحقق تلقائياً من ملف assetlinks.json
   - يتطلب رفع ملف على https://zafaapp.com/.well-known/assetlinks.json

2. android:launchMode="singleTop"
   - يمنع إنشاء نسخة جديدة من Activity عند فتح Deep Link
   - يستدعي onNewIntent() بدلاً من onCreate()

3. android:exported="true"
   - مطلوب لـ Android 12+ للسماح بفتح Activity من خارج التطبيق

4. استبدال الدومين:
   - استبدل "zafaapp.com" بالدومين الفعلي لموقعك
   - يجب أن يكون HTTPS فقط (ليس HTTP)

5. اختبار Deep Links:
   adb shell am start -W -a android.intent.action.VIEW -d "zafa://item/abc123" com.zafa.app
-->
