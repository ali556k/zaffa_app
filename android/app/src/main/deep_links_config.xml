<!-- ======================== -->
<!-- Deep Link Configuration  -->
<!-- ======================== -->

<!-- 1. Deep Link Scheme (zafa://) - يعمل بدون إنترنت -->
<intent-filter>
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    
    <!-- مسارات العناصر -->
    <data
        android:scheme="zafa"
        android:host="item" />
    
    <!-- مسارات المزودين -->
    <data
        android:scheme="zafa"
        android:host="provider" />
    
    <!-- مسارات الحجوزات -->
    <data
        android:scheme="zafa"
        android:host="booking" />
</intent-filter>

<!-- 2. App Links (https://zafaapp.com) - يتطلب التحقق من الدومين -->
<intent-filter android:autoVerify="true">
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    
    <!-- جميع المسارات على نفس الدومين -->
    <data
        android:scheme="https"
        android:host="zafaapp.com" />
    
    <!-- يمكنك تحديد مسارات معينة -->
    <!-- 
    <data
        android:scheme="https"
        android:host="zafaapp.com"
        android:pathPrefix="/item" />
    <data
        android:scheme="https"
        android:host="zafaapp.com"
        android:pathPrefix="/provider" />
    <data
        android:scheme="https"
        android:host="zafaapp.com"
        android:pathPrefix="/booking" />
    -->
</intent-filter>

