rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // قواعد للمستخدمين
    match /users/{userId} {
      allow read, write: if request.auth != null || true; // السماح مؤقتاً للاختبار
    }
    
    // قواعد للخدمات
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    
    // قواعد للخدمات المعتمدة
    match /approved_services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    
    // قواعد للخدمات المعلقة
    match /pending_services/{serviceId} {
      allow read, write: if request.auth != null || true;
    }
    
    // قواعد للجلسات
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null || true;
    }
    
    // قواعد لطلبات مزودي الخدمة
    match /provider_requests/{requestId} {
      allow read, write: if request.auth != null || true;
    }
    
    // قواعد للحجوزات
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null || true;
    }
    
    // قواعد لمحاولات تسجيل الدخول
    match /login_attempts/{attemptId} {
      allow read, write: if request.auth != null || true;
    }
    
    // قواعد لعناصر الخدمة
    match /service_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    
    // قواعد لعناصر الخدمة المعلقة
    match /pending_service_items/{itemId} {
      allow read, write: if request.auth != null || true;
    }
    
    // قواعد لمزودي الخدمة
    match /providers/{providerId} {
      allow read, write: if request.auth != null || true;
    }
    
    // قواعد للرسائل والدردشة
    match /chats/{chatId} {
      allow read, write: if request.auth != null || true;
    }
    
    match /messages/{messageId} {
      allow read, write: if request.auth != null || true;
    }
    
    // السماح بجميع المجموعات الأخرى مؤقتاً للاختبار
    match /{document=**} {
      allow read, write: if true; // مؤقت للاختبار فقط
    }
  }
}
