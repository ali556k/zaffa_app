class ItemDetailsScreen extends StatefulWidget {
  final Map<String, dynamic> item;
  final String providerName;

  const ItemDetailsScreen({
    super.key,
    required this.item,
    required this.providerName,
  });

  @override
  State<ItemDetailsScreen> createState() => _ItemDetailsScreenState();
}

class _ItemDetailsScreenState extends State<ItemDetailsScreen> {
  final PageController _imagePageController = PageController();
  int _currentImageIndex = 0;
  List<String> bookedDates = [];
  bool isLoadingBookedDates = true;
  String? _userId;

  @override
  void initState() {
    super.initState();
    _loadBookedDates();
    _loadUserId();
  }

  Future<void> _loadUserId() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final storedUserId = prefs.getString('user_phone');
      setState(() {
        _userId = storedUserId;
      });

      if (storedUserId != null) {
        print('تم تحميل معرف المستخدم: $storedUserId');
      }
    } catch (e) {
      print('خطأ في تحميل معرف المستخدم: $e');
    }
  }

  Future<void> _loadBookedDates() async {
    try {
      final itemDoc = await FirebaseFirestore.instance
          .collection('published_items')
          .doc(widget.item['itemId'])
          .get();

      if (itemDoc.exists) {
        final data = itemDoc.data();
        setState(() {
          bookedDates = List<String>.from(data?['bookedDates'] ?? []);
          isLoadingBookedDates = false;
        });
      }
    } catch (e) {
      print('خطأ في تحميل التواريخ المحجوزة: $e');
      setState(() {
        isLoadingBookedDates = false;
      });
    }
  }

  @override
  void dispose() {
    _imagePageController.dispose();
    super.dispose();
  }

  // Helper method to safely parse price from different data types
  num _parsePrice(dynamic priceValue) {
    if (priceValue == null) return 0;
    if (priceValue is num) return priceValue;
    if (priceValue is String) {
      try {
        return num.parse(priceValue);
      } catch (e) {
        return 0;
      }
    }
    return 0;
  }

  @override
  Widget build(BuildContext context) {
    final images = ImageUtils.getImages(widget.item);
    final price = _parsePrice(widget.item['price']);

    return Scaffold(
      body: CustomScrollView(
        slivers: [
          // App Bar مع الصور
          SliverAppBar(
            expandedHeight: 300,
            pinned: true,
            backgroundColor: Theme.of(context).appBarTheme.backgroundColor,
            iconTheme: const IconThemeData(color: Colors.white),
            flexibleSpace: FlexibleSpaceBar(
              background: images.isNotEmpty
                  ? Stack(
                      children: [
                        PageView.builder(
                          controller: _imagePageController,
                          onPageChanged: (index) {
                            setState(() {
                              _currentImageIndex = index;
                            });
                          },
                          itemCount: images.length,
                          itemBuilder: (context, index) {
                            return FutureBuilder<String>(
                              future: StorageHelper.getValidImageUrl(
                                images[index].toString(),
                              ),
                              builder: (context, snapshot) {
                                if (snapshot.connectionState ==
                                    ConnectionState.waiting) {
                                  return Center(
                                    child: CircularProgressIndicator(
                                      strokeWidth: 2,
                                      valueColor:
                                          const AlwaysStoppedAnimation<Color>(
                                            Color(0xFFB46A6A),
                                          ),
                                    ),
                                  );
                                }

                                if (snapshot.hasError || !snapshot.hasData) {
                                  return Container(
                                    color: Colors.grey[300],
                                    child: const Center(
                                      child: Icon(
                                        Icons.image_not_supported,
                                        size: 60,
                                        color: Colors.grey,
                                      ),
                                    ),
                                  );
                                }

                                return Image.network(
                                  snapshot.data!,
                                  fit: BoxFit.cover,
                                  errorBuilder: (context, error, stackTrace) {
                                    return Container(
                                      color: Colors.grey[300],
                                      child: const Center(
                                        child: Icon(
                                          Icons.image_not_supported,
                                          size: 60,
                                          color: Colors.grey,
                                        ),
                                      ),
                                    );
                                  },
                                );
                              },
                            );
                          },
                        ),

                        // مؤشر الصور
                        if (images.length > 1)
                          Positioned(
                            bottom: 20,
                            left: 0,
                            right: 0,
                            child: Row(
                              mainAxisAlignment: MainAxisAlignment.center,
                              children: images.asMap().entries.map((entry) {
                                return Container(
                                  width: 8,
                                  height: 8,
                                  margin: const EdgeInsets.symmetric(
                                    horizontal: 3,
                                  ),
                                  decoration: BoxDecoration(
                                    shape: BoxShape.circle,
