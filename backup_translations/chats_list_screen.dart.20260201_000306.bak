import 'package:flutter/material.dart';
import 'package:easy_localization/easy_localization.dart' hide TextDirection;
import 'package:shared_preferences/shared_preferences.dart';
import '../models/chat_models.dart';
import '../services/chat_service.dart';
import '../utils/chat_helper.dart';
import 'chat_room_screen.dart';
import 'package:intl/intl.dart' as intl;

/// شاشة قائمة المحادثات
class ChatsListScreen extends StatefulWidget {
  const ChatsListScreen({super.key});

  @override
  State<ChatsListScreen> createState() => _ChatsListScreenState();
}

class _ChatsListScreenState extends State<ChatsListScreen> {
  final ChatService _chatService = ChatService();
  String? _currentUserId;

  @override
  void initState() {
    super.initState();
    _loadCurrentUserId();
  }

  // تحميل معرف المستخدم فوراً
  Future<void> _loadCurrentUserId() async {
    try {
      final prefs = await SharedPreferences.getInstance();

      // طباعة جميع المفاتيح للتشخيص
      print('🔍 جميع المفاتيح المحفوظة: ${prefs.getKeys()}');

      String? userId =
          prefs.getString('currentUserId') ?? prefs.getString('user_phone');

      // إذا كان المستخدم هو المالك، استخدم رقم المالك مباشرة
      const String ownerPhone = '07721874360';
      if (userId == ownerPhone || userId == null) {
        // تحقق إذا كان هذا هو المالك من خلال رقم الهاتف المحفوظ
        final savedPhone = prefs.getString('user_phone');
        if (savedPhone == ownerPhone) {
          userId = ownerPhone;
          print('👑 تم التعرف على المالك');
        }
      }

      print('👤 معرف المستخدم الحالي: $userId');

      if (mounted) {
        setState(() {
          _currentUserId = userId;
        });

        // إذا لم يتم العثور على معرف، اعرض رسالة
        if (userId == null) {
          print('⚠️ لم يتم العثور على معرف المستخدم في SharedPreferences');
        }
      }
    } catch (e) {
      print('❌ خطأ في تحميل معرف المستخدم: $e');
      if (mounted) {
        setState(() {
          _currentUserId = null;
        });
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFF5F5F5),
      appBar: AppBar(
        elevation: 0,
        backgroundColor: Theme.of(context).appBarTheme.backgroundColor,
        foregroundColor: Theme.of(context).appBarTheme.foregroundColor,
        centerTitle: true,
        title: const Text(
          'المحادثات',
          style: TextStyle(
            fontSize: 20,
            fontWeight: FontWeight.bold,
            color: Colors.white,
          ),
        ),
        actions: _currentUserId != null
            ? [
                // عداد الرسائل غير المقروءة
                StreamBuilder<int>(
                  stream: _chatService.getUnreadCount(_currentUserId!),
                  builder: (context, snapshot) {
                    final unreadCount = snapshot.data ?? 0;
                    if (unreadCount == 0) return const SizedBox.shrink();

                    return Container(
                      margin: const EdgeInsets.only(right: 16, top: 8),
                      padding: const EdgeInsets.symmetric(
                        horizontal: 8,
                        vertical: 4,
                      ),
                      decoration: BoxDecoration(
                        color: Colors.red,
                        borderRadius: BorderRadius.circular(12),
                      ),
                      child: Text(
                        '$unreadCount',
                        style: const TextStyle(
                          color: Colors.white,
                          fontSize: 12,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    );
                  },
                ),
              ]
            : null,
      ),
      body: _currentUserId == null
          ? Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  const CircularProgressIndicator(color: Color(0xFF2B0606)),
                  const SizedBox(height: 16),
                  const Text(
                    'جاري تحميل بياناتك...',
                    style: TextStyle(color: Colors.grey),
                  ),
                  const SizedBox(height: 24),
                  ElevatedButton.icon(
                    onPressed: () {
                      // إعادة المحاولة
                      setState(() {
                        _currentUserId = null;
                      });
                      _loadCurrentUserId();
                    },
                    icon: const Icon(Icons.refresh),
                    label: const Text('إعادة المحاولة'),
                    style: ElevatedButton.styleFrom(
                      backgroundColor: const Color(0xFF2B0606),
                      foregroundColor: Colors.white,
                    ),
                  ),
                ],
              ),
            )
          : StreamBuilder<List<ChatRoom>>(
              stream: _chatService.getChatRooms(_currentUserId!),
              builder: (context, snapshot) {
                if (snapshot.connectionState == ConnectionState.waiting) {
                  return const Center(
                    child: CircularProgressIndicator(color: Color(0xFF2B0606)),
                  );
                }

                if (snapshot.hasError) {
                  return Center(
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        const Icon(
                          Icons.error_outline,
                          size: 64,
                          color: Colors.red,
                        ),
                        const SizedBox(height: 16),
                        Text('حدث خطأ: ${snapshot.error}'),
                      ],
                    ),
                  );
                }

                final chatRooms = snapshot.data ?? [];

                return ListView.separated(
                  itemCount: chatRooms.length + 1, // +1 for support card
                  separatorBuilder: (context, index) =>
                      const Divider(height: 1),
                  itemBuilder: (context, index) {
                    // First item is technical support
                    if (index == 0) {
                      return _buildSupportCard();
                    }
                    // Other items are regular chats
                    final chatRoom = chatRooms[index - 1];
                    return _buildChatListItem(chatRoom, _currentUserId!);
                  },
                );
              },
            ),
    );
  }

  Widget _buildChatListItem(ChatRoom chatRoom, String currentUserId) {
    final otherUserInfo = chatRoom.getOtherUserInfo(currentUserId);
    if (otherUserInfo == null) return const SizedBox.shrink();

    // تحديد الاسم المعروض بناءً على دور المستخدم
    String otherUserName = otherUserInfo['name'] ?? 'مستخدم';
    final otherUserRole = otherUserInfo['role'];
    final serviceName = otherUserInfo['serviceName'];

    // إذا كان المستخدم الآخر مزود خدمة ويوجد اسم خدمة، اعرض اسم الخدمة
    if (otherUserRole == 'provider' && serviceName != null) {
      otherUserName = serviceName;
    }

    final otherUserImage = otherUserInfo['imageUrl'];
    final unreadCount = chatRoom.unreadCount[currentUserId] ?? 0;
    final isLastMessageFromOther = chatRoom.lastSenderId != currentUserId;

    return ListTile(
      contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      leading: Stack(
        children: [
          CircleAvatar(
            radius: 28,
            backgroundColor: const Color(0xFF2B0606),
            backgroundImage: otherUserImage != null
                ? NetworkImage(otherUserImage)
                : null,
            child: otherUserImage == null
                ? Text(
                    otherUserName[0].toUpperCase(),
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 20,
                      fontWeight: FontWeight.bold,
                    ),
                  )
                : null,
          ),
          if (unreadCount > 0 && isLastMessageFromOther)
            Positioned(
              right: 0,
              top: 0,
              child: Container(
                padding: const EdgeInsets.all(4),
                decoration: const BoxDecoration(
                  color: Colors.red,
                  shape: BoxShape.circle,
                ),
                constraints: const BoxConstraints(minWidth: 20, minHeight: 20),
                child: Text(
                  unreadCount > 99 ? '99+' : '$unreadCount',
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 10,
                    fontWeight: FontWeight.bold,
                  ),
                  textAlign: TextAlign.center,
                ),
              ),
            ),
        ],
      ),
      title: Text(
        otherUserName,
        style: TextStyle(
          fontSize: 16,
          fontWeight: unreadCount > 0 && isLastMessageFromOther
              ? FontWeight.bold
              : FontWeight.w500,
        ),
      ),
      subtitle: Text(
        chatRoom.lastMessage ?? 'ابدأ المحادثة',
        maxLines: 1,
        overflow: TextOverflow.ellipsis,
        style: TextStyle(
          fontSize: 14,
          color: unreadCount > 0 && isLastMessageFromOther
              ? Colors.black87
              : Colors.grey[600],
          fontWeight: unreadCount > 0 && isLastMessageFromOther
              ? FontWeight.w600
              : FontWeight.normal,
        ),
      ),
      trailing: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        crossAxisAlignment: CrossAxisAlignment.end,
        children: [
          Text(
            _formatTimestamp(chatRoom.lastTimestamp),
            style: TextStyle(
              fontSize: 12,
              color: unreadCount > 0 && isLastMessageFromOther
                  ? const Color(0xFF2B0606)
                  : Colors.grey[600],
              fontWeight: unreadCount > 0 && isLastMessageFromOther
                  ? FontWeight.bold
                  : FontWeight.normal,
            ),
          ),
        ],
      ),
      onTap: () {
        Navigator.push(
          context,
          MaterialPageRoute(
            builder: (context) => ChatRoomScreen(
              chatId: chatRoom.id,
              otherUserId: chatRoom.getOtherUserId(currentUserId),
              otherUserName: otherUserName,
              otherUserImage: otherUserImage,
            ),
          ),
        );
      },
    );
  }

  String _formatTimestamp(DateTime? timestamp) {
    if (timestamp == null) return '';

    final now = DateTime.now();
    final difference = now.difference(timestamp);

    if (difference.inDays == 0) {
      return intl.DateFormat('HH:mm').format(timestamp);
    } else if (difference.inDays == 1) {
      return 'أمس';
    } else if (difference.inDays < 7) {
      return intl.DateFormat('EEEE', 'ar').format(timestamp);
    } else {
      return intl.DateFormat('dd/MM/yyyy').format(timestamp);
    }
  }

  Widget _buildSupportCard() {
    return Container(
      margin: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Theme.of(context).appBarTheme.backgroundColor,
        borderRadius: BorderRadius.circular(16),
        boxShadow: const [
          BoxShadow(
            color: Color(0x33000000),
            blurRadius: 8,
            offset: Offset(0, 4),
          ),
        ],
      ),
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          onTap: () async {
            try {
              await ChatHelper.startChatWithOwner(context);
            } catch (e) {
              if (mounted) {
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                    content: Text('خطأ في فتح الدعم الفني: $e'),
                    backgroundColor: Colors.red,
                  ),
                );
              }
            }
          },
          borderRadius: BorderRadius.circular(16),
          child: Padding(
            padding: const EdgeInsets.all(16),
            child: Row(
              children: [
                Container(
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    color: Colors.white.withOpacity(0.15),
                    shape: BoxShape.circle,
                  ),
                  child: const Icon(
                    Icons.support_agent,
                    color: Colors.white,
                    size: 32,
                  ),
                ),
                const SizedBox(width: 16),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'الدعم الفني',
                        style: TextStyle(
                          color: Colors.white,
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      const SizedBox(height: 4),
                      Text(
                        'تواصل معنا مباشرة - متاح 24/7',
                        style: TextStyle(
                          color: Colors.white.withOpacity(0.9),
                          fontSize: 14,
                        ),
                      ),
                    ],
                  ),
                ),
                Icon(
                  Icons.arrow_forward_ios,
                  color: Colors.white.withOpacity(0.8),
                  size: 20,
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}
