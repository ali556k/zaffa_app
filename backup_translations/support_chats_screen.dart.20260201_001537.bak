import 'package:flutter/material.dart';
import 'package:easy_localization/easy_localization.dart' hide TextDirection;
import 'package:cloud_firestore/cloud_firestore.dart';

class SupportChatsScreen extends StatelessWidget {
  final String ownerPhone;
  const SupportChatsScreen({super.key, required this.ownerPhone});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('محادثات الدعم الفني', style: TextStyle(fontWeight: FontWeight.bold, color: Colors.white)),
        backgroundColor: const Color(0xFF1E88E5),
        elevation: 0,
        shape: const RoundedRectangleBorder(
          borderRadius: BorderRadius.vertical(bottom: Radius.circular(24)),
        ),
        iconTheme: const IconThemeData(color: Colors.white),
      ),
      backgroundColor: const Color(0xFFF5F7FA),
      body: StreamBuilder<QuerySnapshot>(
        stream: FirebaseFirestore.instance.collection('chats').snapshots(),
        builder: (context, snapshot) {
          if (!snapshot.hasData) return const Center(child: CircularProgressIndicator());
          final chats = snapshot.data!.docs.where((doc) => doc.id.startsWith('support-')).toList();
          if (chats.isEmpty) {
            return const Center(child: Text('لا توجد محادثات دعم فني بعد'));
          }
          return ListView.builder(
            itemCount: chats.length,
            itemBuilder: (context, index) {
              final chat = chats[index];
              final chatId = chat.id;
              final userPhone = chatId.split('-')[1];
              return FutureBuilder<DocumentSnapshot>(
                future: FirebaseFirestore.instance.collection('users').doc(userPhone).get(),
                builder: (context, userSnap) {
                  final userData = userSnap.data?.data() as Map<String, dynamic>?;
                  final isProvider = (userData?['role'] ?? '').toString().toLowerCase().contains('provider') || (userData?['isProvider'] == true);
                  final displayName = userData?['name'] ?? 'مستخدم';
                  return ListTile(
                    leading: isProvider
                        ? const Icon(Icons.verified, color: Colors.blue)
                        : const Icon(Icons.person),
                    title: Text(isProvider ? 'مزود خدمة: $displayName' : 'مستخدم: $displayName'),
                    subtitle: Text('رقم الهاتف: $userPhone'),
                    trailing: isProvider ? const Chip(label: Text('مزود خدمة', style: TextStyle(color: Colors.white)), backgroundColor: Colors.blue) : null,
                    onTap: () {
                      Navigator.of(context).pushNamed(
                        '/chat',
                        arguments: {
                          'chatId': chatId,
                          'currentUserId': ownerPhone,
                          'supportMode': false,
                          'supportId': ownerPhone,
                        },
                      );
                    },
                  );
                },
              );
            },
          );
        },
      ),
    );
  }
}
