// شاشة إضافة عناصر الخدمة لمزود الخدمة
class ProviderServiceItemsScreen extends StatefulWidget {
  const ProviderServiceItemsScreen({super.key});

  @override
  State<ProviderServiceItemsScreen> createState() =>
      _ProviderServiceItemsScreenState();
}

class _ProviderServiceItemsScreenState
    extends State<ProviderServiceItemsScreen> {
  bool hasSubmittedInitialServices = false;
  List<Map<String, dynamic>> services = [];
  Map<String, List<Map<String, dynamic>>> serviceItems = {};
  Map<String, List<Map<String, dynamic>>> pendingItems = {};
  Map<String, dynamic>? providerInfo;
  String? currentUserId;
  bool isLoading = true;

  @override
  void initState() {
    super.initState();
    _loadUserData();
  }

  Future<void> _loadUserData() async {
    final prefs = await SharedPreferences.getInstance();
    currentUserId = prefs.getString('user_phone');
    if (currentUserId != null) {
      await _checkInitialSubmission();
      if (hasSubmittedInitialServices) {
        await _loadUserServices();
        await _loadProviderInfo();
        await _loadAllItems();
      }
    }
    setState(() {
      isLoading = false;
    });
  }

  Future<void> _loadProviderInfo() async {
    if (currentUserId == null) return;
    final userDoc = await FirebaseFirestore.instance
        .collection('users')
        .doc(currentUserId)
        .get();
    if (userDoc.exists) {
      providerInfo = userDoc.data();
    }
  }

  Future<void> _loadAllItems() async {
    serviceItems.clear();
    pendingItems.clear();
    for (var service in services) {
      final serviceId = service['id'];
      // العناصر المعتمدة
      final itemsSnap = await FirebaseFirestore.instance
          .collection('service_items')
          .where('serviceId', isEqualTo: serviceId)
          .get();
      serviceItems[serviceId] = itemsSnap.docs.map((doc) {
        final data = doc.data();
        data['id'] = doc.id;
        return data;
      }).toList();
      // العناصر المعلقة
      final pendingSnap = await FirebaseFirestore.instance
          .collection('pending_service_items')
          .where('serviceId', isEqualTo: serviceId)
          .get();
      pendingItems[serviceId] = pendingSnap.docs.map((doc) {
        final data = doc.data();
        data['id'] = doc.id;
        return data;
      }).toList();
    }
    setState(() {});
  }

  Future<void> _checkInitialSubmission() async {
    if (currentUserId == null) return;
    final userDoc = await FirebaseFirestore.instance
        .collection('users')
        .doc(currentUserId)
        .get();
    if (userDoc.exists) {
      final userData = userDoc.data() as Map<String, dynamic>;
      hasSubmittedInitialServices =
          userData['hasSubmittedInitialServices'] ?? false;
    }
  }

  // جلب الخدمات المعتمدة فقط من approved_services
  Future<void> _loadUserServices() async {
    if (currentUserId == null) return;
    final servicesSnapshot = await FirebaseFirestore.instance
        .collection('approved_services')
        .where('providerId', isEqualTo: currentUserId)
        .get();
    setState(() {
      services = servicesSnapshot.docs.map((doc) {
        final data = doc.data();
        data['id'] = doc.id;
        return data;
      }).toList();
    });
  }

  @override
  Widget build(BuildContext context) {
    if (isLoading) {
      return Scaffold(
        appBar: AppBar(title: Text('خدماتي')),
        body: Center(child: CircularProgressIndicator()),
      );
    }

    if (!hasSubmittedInitialServices) {
      return _buildInitialServiceForm();
    } else {
      return _buildServicesManagement();
    }
  }

  Widget _buildInitialServiceForm() {
    return ServiceFormScreen(
      isInitial: true,
      onSubmit: (serviceData) async {
        await _submitInitialService(serviceData);
      },
    );
  }

  // void _showDeleteConfirmation(Map<String, dynamic> service) {
  //   showDialog(
  //     context: context,
  //     builder: (context) => AlertDialog(
  //       title: Text('حذف الخدمة'),
  //       content: Text('هل أنت متأكد من حذف خدمة "${service['name']}"؟'),
  //       actions: [
  //         TextButton(
  //           onPressed: () => Navigator.pop(context),
  //           child: Text('cancel'.tr()),
  //         ),
  //         TextButton(
  //           onPressed: () async {
  //             Navigator.pop(context);
  //             await _deleteService(service['id']);
  //           },
  //           child: Text('حذف', style: TextStyle(color: Colors.red)),
  //         ),
  //       ],
  //     ),
  //   );
  // }

  Future<void> _submitInitialService(Map<String, dynamic> serviceData) async {
    if (currentUserId == null) return;
    try {
      final serviceRef = FirebaseFirestore.instance
          .collection('pending_services')
          .doc();
      serviceData['id'] = serviceRef.id;
      serviceData['providerId'] = currentUserId;
      serviceData['createdAt'] = FieldValue.serverTimestamp();
      serviceData['bookedDates'] = <String>[];
      serviceData['status'] = 'pending';
      if (!serviceData.containsKey('category') ||
          serviceData['category'] == null ||
          serviceData['category'].toString().isEmpty) {
        serviceData['category'] = 'other';
      }
      await serviceRef.set(serviceData);
      await FirebaseFirestore.instance
          .collection('users')
          .doc(currentUserId)
          .update({'hasSubmittedInitialServices': true});
      await FirebaseFirestore.instance.collection('provider_requests').add({
        'providerId': currentUserId,
        'services': [serviceData],
        'status': 'pending',
        'createdAt': FieldValue.serverTimestamp(),
        'type': 'initial_submission',
      });
      setState(() {
        hasSubmittedInitialServices = true;
        services = [serviceData];
      });
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('تم إرسال الخدمة للموافقة بنجاح!'),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('حدث خطأ: $e')));
    }
  }

  // Future<void> _deleteService(String serviceId) async {
  //   if (currentUserId == null) return;
  //   try {
  //     await FirebaseFirestore.instance.collection('pending_services').doc(serviceId).delete();
  //     await FirebaseFirestore.instance.collection('provider_edit_requests').add({
  //       'providerId': currentUserId,
