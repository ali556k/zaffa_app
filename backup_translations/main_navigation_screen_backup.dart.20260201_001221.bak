class MainNavigationScreen extends StatefulWidget {
  final bool isAdmin;
  const MainNavigationScreen({super.key, this.isAdmin = false});

  @override
  State<MainNavigationScreen> createState() => _MainNavigationScreenState();
}

class _MainNavigationScreenState extends State<MainNavigationScreen> {
  int _selectedIndex = 0;

  String? _currentUserId;

  @override
  void initState() {
    super.initState();
    _loadCurrentUserId();
  }

  Future<void> _loadCurrentUserId() async {
    final prefs = await SharedPreferences.getInstance();
    final phone = prefs.getString('user_phone');
    setState(() {
      _currentUserId = phone ?? '';
    });
    print('Loaded currentUserId: $_currentUserId');
  }

  static const String ownerPhone = '07721874360';
  List<Widget> get _pages {
    if (widget.isAdmin) {
      // صفحات مزود الخدمة
      return [
        ProviderServiceItemsScreen(), // إضافة عناصر الخدمة
        ProviderBookingsScreen(), // الحجوزات
        ProviderAccountScreen(), // الحساب
        ProviderSupportScreen(), // الدعم الفني
      ];
    } else {
      // صفحات العميل العادي
      return [
        ServicesScreen(),
        WeddingDayScreen(),
        ProfileScreen(),
        MyBookingsScreen(),
        FazaaScreen(),
        // الدعم الفني:
        if (_currentUserId != null)
          (_currentUserId == ownerPhone)
              ? SupportChatsScreen(ownerPhone: ownerPhone)
              : ChatRoomScreen(
                  chatId: 'support-${_currentUserId!}-$ownerPhone',
                  currentUserId: _currentUserId!,
                  otherUserId: ownerPhone,
                  otherUserName: 'الدعم الفني',
                  key: ValueKey('support-${_currentUserId!}-$ownerPhone'),
                )
        else
          const Scaffold(body: Center(child: CircularProgressIndicator())),
      ];
    }
  }

  @override
  Widget build(BuildContext context) {
    if (_currentUserId == null) {
      // إظهار شاشة تسجيل الدخول مع زر للانتقال إلى شاشة إنشاء حساب
      return Scaffold(
        body: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const Text(
                'يرجى تسجيل الدخول أولاً',
                style: TextStyle(fontSize: 20),
              ),
              const SizedBox(height: 24),
              ElevatedButton(
                onPressed: () {
                  Navigator.of(context).pushReplacement(
                    MaterialPageRoute(builder: (_) => const LoginScreen()),
                  );
                },
                child: const Text('login'.tr()),
              ),
            ],
          ),
        ),
      );
    }
    return AnnotatedRegion<SystemUiOverlayStyle>(
      value: const SystemUiOverlayStyle(
        statusBarColor: Colors.transparent,
        statusBarIconBrightness: Brightness.dark,
        statusBarBrightness: Brightness.light,
      ),
      child: Scaffold(
        extendBodyBehindAppBar: true,
        backgroundColor: const Color.fromARGB(255, 216, 208, 208),
        body: Stack(
          children: [
            // الصفحة الحالية
            Positioned.fill(child: _pages[_selectedIndex]),
            // تم إلغاء العنوان مؤقتًا لاختبار الخط الأبيض
            // if (_selectedIndex != 0)
            //   Positioned(
            //     top: 0,
            //     left: 0,
            //     right: 0,
            //     child: CustomPageTitle(_titles[_selectedIndex]),
            //   ),
          ],
        ),
        bottomNavigationBar: Directionality(
          textDirection: TextDirection.rtl,
          child: BottomNavigationBar(
            type: BottomNavigationBarType.fixed,
            currentIndex: _selectedIndex,
            onTap: (index) => setState(() => _selectedIndex = index),
            selectedItemColor: const Color(0xFFB46A6A),
            unselectedItemColor: Colors.grey,
            items: widget.isAdmin
                ? [
                    // صفحات مزود الخدمة
                    BottomNavigationBarItem(
                      icon: Icon(Icons.add_business),
                      label: 'إضافة عناصر',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.book_online),
                      label: 'الحجوزات',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.account_circle),
                      label: 'الحساب',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.support_agent),
                      label: 'الدعم الفني',
                    ),
                  ]
                : [
                    // صفحات العميل العادي
                    BottomNavigationBarItem(
                      icon: Icon(Icons.home),
                      label: 'الرئيسية',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.favorite),
                      label: 'يوم الزفاف',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.person),
                      label: 'الملف الشخصي',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.book),
                      label: 'حجوزاتي',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.celebration),
                      label: 'زفة',
                    ),
                  ],
          ),
        ),
      ),
    );
  }
}

// شاشة الحساب (فارغة مؤقتاً)
class ProfileScreen extends StatefulWidget {
  const ProfileScreen({super.key});

  @override
  State<ProfileScreen> createState() => _ProfileScreenState();
}

class _ProfileScreenState extends State<ProfileScreen> {
  @override
  Widget build(BuildContext context) {
    // معرفة رقم المالك
    const String ownerPhone = '07721874360';
    return Container(
      color: const Color.fromARGB(255, 216, 208, 208),
      child: Scaffold(
        backgroundColor: Colors.transparent,
        body: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            crossAxisAlignment: CrossAxisAlignment.center,
            children: [
              CustomPageTitle('الحساب'),
              const SizedBox(height: 24),
              const Text('معلومات الحساب', style: TextStyle(fontSize: 20)),
              const SizedBox(height: 32),
              // زر الطلبات المرسلة لمزودي الخدمة للمالك فقط
              FutureBuilder<SharedPreferences>(
                future: SharedPreferences.getInstance(),
                builder: (context, snapshot) {
                  if (!snapshot.hasData) return const SizedBox.shrink();
                  final prefs = snapshot.data!;
                  final phone = prefs.getString('user_phone') ?? '';
                  if (phone == ownerPhone) {
                    return Column(
                      children: [
                        ElevatedButton.icon(
                          icon: const Icon(Icons.assignment),
                          label: const Text('طلبات مزودي الخدمة المرسلة'),
                          style: ElevatedButton.styleFrom(
                            backgroundColor: const Color(0xFF1E88E5),
                            foregroundColor: Colors.white,
                            padding: const EdgeInsets.symmetric(
                              horizontal: 32,
                              vertical: 16,
                            ),
                            shape: RoundedRectangleBorder(
                              borderRadius: BorderRadius.circular(12),
                            ),
                          ),
                          onPressed: () {
                            Navigator.push(
                              context,
                              MaterialPageRoute(
                                builder: (context) => Scaffold(
                                  appBar: AppBar(
                                    title: Text("طلبات مزودي الخدمة المرسلة"),
                                  ),
                                  body: Center(
                                    child: Text(
                                      "هنا يمكنك إدارة طلبات مزودي الخدمة المرسلة",
                                    ),
                                  ),
                                ),
                              ),
                            );
                          },
                        ),
                        const SizedBox(height: 16),
                      ],
                    );
                  } else {
                    // إخفاء زر تحويل الحساب إلى مزود خدمة
                    return Column(
                      children: [
                        // ...يمكنك إضافة عناصر أخرى هنا إذا رغبت...
                      ],
                    );
                  }
                },
              ),
              const SizedBox(height: 24),
              ElevatedButton.icon(
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.white,
                  foregroundColor: const Color(0xFFB46A6A),
                  padding: const EdgeInsets.symmetric(
                    horizontal: 32,
                    vertical: 16,
                  ),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(12),
                  ),
                  side: const BorderSide(color: Color(0xFFB46A6A)),
                ),
                icon: const Icon(Icons.logout),
                label: const Text(
                  'تسجيل الخروج',
                  style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                ),
                onPressed: () async {
                  try {
                    final prefs = await SharedPreferences.getInstance();
                    final phone = prefs.getString('user_phone');
                    if (phone != null && phone.isNotEmpty) {
                      await FirebaseFirestore.instance
                          .collection('sessions')
                          .doc(phone)
                          .update({'active': false});
                      await prefs.remove('user_phone');
                    }
                    Navigator.pushAndRemoveUntil(
                      context,
                      MaterialPageRoute(builder: (_) => SplashScreen()),
                      (route) => false,
                    );
                  } catch (e) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(content: Text('حدث خطأ أثناء تسجيل الخروج: $e')),
                    );
                  }
                },
              ),
            ],
          ),
        ),
      ),
    );
  }
}

