                  ElevatedButton.icon(
                    icon: Icon(Icons.edit, size: 18),
                    label: Text('edit'.tr()),
                    style: ElevatedButton.styleFrom(
                      backgroundColor: Colors.blue,
                      foregroundColor: Colors.white,
                    ),
                    onPressed: () {
                      // ...تعديل الخدمة...
                    },
                  ),
                  SizedBox(width: 8),
                  ElevatedButton.icon(
                    icon: Icon(Icons.delete, size: 18),
                    label: Text('delete'.tr()),
