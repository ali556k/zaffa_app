import 'package:flutter/material.dart';
import 'package:easy_localization/easy_localization.dart' hide TextDirection;
import 'package:cloud_firestore/cloud_firestore.dart';
import 'dart:async';
import 'package:google_maps_flutter/google_maps_flutter.dart';
import 'package:url_launcher/url_launcher.dart';
import '../utils/chat_helper.dart';
import '../utils/price_formatter.dart';

class AdminProviderRequestsScreen extends StatefulWidget {
  const AdminProviderRequestsScreen({Key? key}) : super(key: key);

  @override
  State<AdminProviderRequestsScreen> createState() =>
      _AdminProviderRequestsScreenState();
}

class _AdminProviderRequestsScreenState
    extends State<AdminProviderRequestsScreen> {
  List<Map<String, dynamic>> _providerRequests = [];
  bool _isLoading = true;

  // تطبيع رقم الهاتف لإزالة المسافات والبادئات الشائعة
  String _normalizePhone(dynamic phone) {
    if (phone == null) return '';
    String p = phone.toString().trim();
    p = p
        .replaceAll(' ', '')
        .replaceAll('-', '')
        .replaceAll('(', '')
        .replaceAll(')', '');
    // إزالة بادئة +964 وتحويلها إلى 0
    if (p.startsWith('+964')) {
      p = '0' + p.substring(4);
    }
    // إزالة 00964 أيضاً
    if (p.startsWith('00964')) {
      p = '0' + p.substring(5);
    }
    return p;
  }

  @override
  void initState() {
    super.initState();
    _loadProviderRequests();
  }

  // يبني مفتاح فريد لعنصر بالاعتماد على الاسم والسعر والتفاصيل (بعد تنظيفها)
  String _buildItemKey(Map<String, dynamic> item) {
    final name = (item['name'] ?? '').toString().trim();
    final details = (item['details'] ?? '').toString().trim();
    final price = (item['price'] ?? '').toString().replaceAll(',', '').trim();
    return '${name.toLowerCase()}|${price}|${details.toLowerCase()}';
  }

  @override
  void dispose() {
    super.dispose();
  }

  Future<void> _loadProviderRequests() async {
    if (!mounted) return;
    setState(() {
      _isLoading = true;
    });

    try {
      print('🔍 بدء تحميل طلبات مزودي الخدمة...');

      // البحث في مجموعة provider_requests (الطلبات الجديدة)
      final requestsSnapshot = await FirebaseFirestore.instance
          .collection('provider_requests')
          .orderBy('createdAt', descending: true)
          .get();

      print(
        '📊 عدد الطلبات في provider_requests: ${requestsSnapshot.docs.length}',
      );

      List<Map<String, dynamic>> requests = [];

      for (var requestDoc in requestsSnapshot.docs) {
        final requestData = requestDoc.data();
        final requestId = requestDoc.id;

        print('📋 طلب جديد: $requestId');
        print('📄 بيانات الطلب: $requestData');

        // إضافة معرف الطلب للبيانات
        requestData['requestId'] = requestId;

        // محاولة تحديد إن كان المزود مسجلاً مسبقاً عبر published_providers
        try {
          final rawPhone =
              requestData['userPhone'] ??
              requestData['providerPhone'] ??
              requestData['phone'];
          final normPhone = _normalizePhone(rawPhone);
          bool found = false;

          // 1) محاولة مباشرة عبر الهاتف المطبع
          if (normPhone.isNotEmpty) {
            final publishedSnap = await FirebaseFirestore.instance
                .collection('published_providers')
                .where('providerPhone', isEqualTo: normPhone)
                .limit(1)
                .get();
            if (publishedSnap.docs.isNotEmpty) {
              final publishedData = publishedSnap.docs.first.data();
              requestData['isRegisteredProvider'] = true;
              requestData['providerId'] =
                  publishedData['providerId'] ?? publishedSnap.docs.first.id;
              requestData['published'] = publishedData['published'] ?? true;
              requestData['isPublished'] =
                  publishedData['isPublished'] ??
                  publishedData['published'] ??
                  true;
              requestData['status'] =
                  publishedData['status'] ?? requestData['status'];
              found = true;
            }
          }

          // 2) إن لم يُعثر، جرّب مطابقة عبر provider_services ثم published_providers عبر providerId
          if (!found && normPhone.isNotEmpty) {
            final providerServicesSnap = await FirebaseFirestore.instance
                .collection('provider_services')
                .where('providerPhone', isEqualTo: normPhone)
                .limit(1)
                .get();
            if (providerServicesSnap.docs.isNotEmpty) {
              final psData = providerServicesSnap.docs.first.data();
              final psProviderId =
                  (psData['providerId'] ?? providerServicesSnap.docs.first.id)
                      .toString();
              final pubByIdSnap = await FirebaseFirestore.instance
                  .collection('published_providers')
                  .where('providerId', isEqualTo: psProviderId)
                  .limit(1)
                  .get();
              if (pubByIdSnap.docs.isNotEmpty) {
                final publishedData = pubByIdSnap.docs.first.data();
                requestData['isRegisteredProvider'] = true;
                requestData['providerId'] =
                    publishedData['providerId'] ?? pubByIdSnap.docs.first.id;
                requestData['published'] = publishedData['published'] ?? true;
                requestData['isPublished'] =
                    publishedData['isPublished'] ??
                    publishedData['published'] ??
                    true;
                requestData['status'] =
                    publishedData['status'] ?? requestData['status'];
                found = true;
              }
            }
          }

          // 3) لو لم يُعثر، اتركها False مع طباعة لمساعدتنا بالتشخيص
          requestData['isRegisteredProvider'] =
              requestData['isRegisteredProvider'] == true || found;
          print(
            '🔎 NEW REQUEST $requestId | phoneRaw=$rawPhone norm=$normPhone | isRegistered=${requestData['isRegisteredProvider']}',
          );
        } catch (e) {
          print(
            '⚠️ فشل التحقق من حالة المزود في published_providers للطلب $requestId: $e',
          );
        }

        requests.add({'type': 'new_request', 'requestData': requestData});
      }

      // البحث في مجموعة provider_services (المزودين المسجلين)
      final providersSnapshot = await FirebaseFirestore.instance
          .collection('provider_services')
          .get();

      print('📊 عدد مزودي الخدمة المسجلين: ${providersSnapshot.docs.length}');

      // قائمة لتتبع المزودين المُضافين لتجنب التكرار
      Set<String> addedProviders = <String>{};

      for (var providerDoc in providersSnapshot.docs) {
        final providerData = providerDoc.data();
        // تطبيع معرف المزود لضمان التوافق مع حقول مختلفة
        final providerId =
            (providerData['providerId'] ??
                    providerData['id'] ??
                    providerData['providerID'] ??
                    providerDoc.id)
                .toString();

        // تجنب إضافة نفس المزود مرتين
        if (addedProviders.contains(providerId)) {
          print('⚠️ تم تجاهل المزود المكرر: $providerId');
          continue;
        }

        print('👤 معالجة مزود الخدمة المسجل: $providerId');
        print('📋 بيانات المزود: $providerData');

        // محاولة إثراء بيانات المزود بحالة النشر/الموافقة من published_providers
        try {
          final publishedSnap = await FirebaseFirestore.instance
              .collection('published_providers')
              .where('providerId', isEqualTo: providerId)
              .limit(1)
              .get();
          if (publishedSnap.docs.isNotEmpty) {
            final publishedData = publishedSnap.docs.first.data();
            providerData['published'] = publishedData['published'] ?? true;
            providerData['isPublished'] =
                publishedData['isPublished'] ??
                publishedData['published'] ??
                true;
            providerData['status'] =
                publishedData['status'] ?? providerData['status'];
            providerData['approved'] =
                publishedData['approved'] ?? providerData['approved'];
            providerData['approvedByOwner'] =
                publishedData['approvedByOwner'] ??
                providerData['approvedByOwner'];
            providerData['ownerApproved'] =
                publishedData['ownerApproved'] ?? providerData['ownerApproved'];
            print(
              '✅ تم العثور على المزود منشور في published_providers: $providerId',
            );
          } else {
            print(
              'ℹ️ لم يتم العثور على سجل في published_providers لـ: $providerId',
            );
          }
        } catch (e) {
          print('⚠️ فشل إثراء بيانات المزود من published_providers: $e');
        }

        // تحميل العناصر لكل مزود خدمة
        final itemsSnapshot = await FirebaseFirestore.instance
            .collection('provider_items')
            .where('providerId', isEqualTo: providerId)
            .get();

        print(
          '📦 عدد العناصر للمزود $providerId: ${itemsSnapshot.docs.length}',
        );

        List<Map<String, dynamic>> providerItems = [];
        List<Map<String, dynamic>> pendingItems = [];
        Set<String> addedItems = <String>{}; // لتجنب تكرار العناصر

        for (var itemDoc in itemsSnapshot.docs) {
          final itemData = itemDoc.data();
          final itemId = itemDoc.id;

          // تجنب إضافة نفس العنصر مرتين
          if (addedItems.contains(itemId)) {
            print('  ⚠️ تم تجاهل العنصر المكرر: $itemId');
            continue;
          }

          itemData['id'] = itemId;
          providerItems.add(itemData);
          // مفتاح فريد يعتمد على البيانات الأساسية لضمان عدم التكرار عبر المصادر المختلفة
          final key = _buildItemKey(itemData);
          addedItems.add(key);

          // فصل العناصر المعلقة
          if (itemData['status'] == 'pending') {
            pendingItems.add(itemData);
            print('  📄 عنصر معلق: ${itemData['name']}');
          } else {
            print(
              '  📄 عنصر: ${itemData['name']} - حالة: ${itemData['status']}',
            );
          }
        }

        // تعويض العناصر المعلقة من provider_requests في حال لم تظهر بعد في provider_items
        try {
          final pendingRequestsSnapshot = await FirebaseFirestore.instance
              .collection('provider_requests')
              .where('providerId', isEqualTo: providerId)
              .where('status', isEqualTo: 'pending')
              .where('type', isEqualTo: 'provider_service_items')
              .get();

          for (var reqDoc in pendingRequestsSnapshot.docs) {
            final reqData = reqDoc.data();
            final reqItems = (reqData['items'] as List?) ?? const [];
            for (var rawItem in reqItems) {
              // تأكد من شكل الخريطة
              final itemData = Map<String, dynamic>.from(rawItem as Map);
              final uniqueKey = _buildItemKey(itemData);
              if (!addedItems.contains(uniqueKey)) {
                // أضف كعنصر معلق لإظهاره في واجهة المسؤول
                pendingItems.add({
                  ...itemData,
                  'status': itemData['status'] ?? 'pending',
                });
                addedItems.add(uniqueKey);
              }
            }
          }
        } catch (e) {
          print(
            '⚠️ فشل جلب عناصر الطلبات المعلقة من provider_requests للمزود $providerId: $e',
          );
        }

        // إضافة المزود إذا كان لديه عناصر
        if (providerItems.isNotEmpty || providerData.isNotEmpty) {
          // إذا كان لديه عناصر معلقة، أضفه كطلب عنصر جديد
          if (pendingItems.isNotEmpty) {
            requests.add({
              'type': 'new_item_request',
              'providerId': providerId,
              'providerData': providerData,
              'items': providerItems,
              'pendingItems': pendingItems,
            });
            print(
              '✅ تم إضافة طلب عنصر جديد للمزود: $providerId مع ${pendingItems.length} عنصر معلق',
            );
          } else {
            // إذا لم يكن لديه عناصر معلقة، أضفه كمزود عادي
            requests.add({
              'type': 'registered_provider',
              'providerId': providerId,
              'providerData': providerData,
              'items': providerItems,
            });
            print(
              '✅ تم إضافة المزود: $providerId مع ${providerItems.length} عنصر',
            );
          }
          addedProviders.add(providerId);
        }
      }

      print('✅ إجمالي الطلبات المُحمّلة: ${requests.length}');

      // ترتيب الطلبات حسب التاريخ (الأحدث أولاً)
      requests.sort((a, b) {
        DateTime? dateA;
        DateTime? dateB;

        if (a['type'] == 'new_request') {
          final requestData = a['requestData'];
          if (requestData['submittedAt'] != null) {
            dateA = (requestData['submittedAt'] as Timestamp).toDate();
          } else if (requestData['createdAt'] != null) {
            dateA = (requestData['createdAt'] as Timestamp).toDate();
          }
        }

        if (b['type'] == 'new_request') {
          final requestData = b['requestData'];
          if (requestData['submittedAt'] != null) {
            dateB = (requestData['submittedAt'] as Timestamp).toDate();
          } else if (requestData['createdAt'] != null) {
            dateB = (requestData['createdAt'] as Timestamp).toDate();
          }
        }

        // إذا لم نجد تاريخ، نضع العنصر في النهاية
        if (dateA == null && dateB == null) return 0;
        if (dateA == null) return 1;
        if (dateB == null) return -1;

        return dateB.compareTo(dateA); // الأحدث أولاً
      });

      print('🗂️ تم ترتيب ${requests.length} طلب حسب التاريخ');

      if (!mounted) return;
      setState(() {
        _providerRequests = requests;
        _isLoading = false;
      });
    } catch (e) {
      print('❌ خطأ في تحميل طلبات مزودي الخدمة: $e');
      if (mounted) {
        setState(() {
          _isLoading = false;
        });
        ScaffoldMessenger.of(
          context,
        ).showSnackBar(SnackBar(content: Text('خطأ في تحميل البيانات: $e')));
      }
    }
  }

  // دالة إرسال طلب تجريبي
  Future<void> _sendTestRequest() async {
    try {
      await FirebaseFirestore.instance.collection('provider_requests').add({
        'serviceName': 'خدمة تجريبية',
        'userPhone': '07700000000',
        'userName': 'مزود تجريبي',
        'governorate': 'بغداد',
        'description': 'هذا طلب اختبار للتأكد من وصول الطلبات',
        'submittedAt': FieldValue.serverTimestamp(),
        'createdAt': FieldValue.serverTimestamp(),
        'status': 'pending',
        'type': 'test_request',
        'items': [
          {
            'name': 'عنصر تجريبي',
            'details': 'وصف العنصر التجريبي',
            'price': '100000',
            'imageUrls': ['https://via.placeholder.com/300'],
            'capacity': '100 شخص',
          },
        ],
      });

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('تم إرسال الطلب التجريبي بنجاح! اضغط تحديث لرؤيته'),
          backgroundColor: Colors.green,
        ),
      );

      // تحديث القائمة
      _loadProviderRequests();
    } catch (e) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('خطأ في الإرسال: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('طلبات مزودي الخدمة المرسلة'),
        backgroundColor: const Color(0xFF530405),
        foregroundColor: Colors.white,
        actions: [
          IconButton(
            icon: const Icon(Icons.refresh),
            onPressed: _loadProviderRequests,
            tooltip: 'تحديث القائمة',
          ),
          PopupMenuButton<String>(
            onSelected: (value) {
              if (value == 'update_approved') {
                _updateAllApprovedItemsStatus();
              }
            },
            itemBuilder: (context) => [
              const PopupMenuItem(
                value: 'update_approved',
                child: Row(
                  children: [
                    Icon(Icons.update, color: Colors.blue),
                    SizedBox(width: 8),
                    Text('تحديث العناصر المعتمدة'),
                  ],
                ),
              ),
            ],
            tooltip: 'خيارات إضافية',
          ),
        ],
      ),
      body: _isLoading
          ? const Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  CircularProgressIndicator(color: Color(0xFF1E88E5)),
                  SizedBox(height: 16),
                  Text('جاري تحميل طلبات مزودي الخدمة...'),
                ],
              ),
            )
          : _providerRequests.isEmpty
          ? RefreshIndicator(
              onRefresh: _loadProviderRequests,
              child: SingleChildScrollView(
                physics: const AlwaysScrollableScrollPhysics(),
                child: Container(
                  height: MediaQuery.of(context).size.height - 200,
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      const Icon(
                        Icons.assignment_outlined,
                        size: 64,
                        color: Colors.grey,
                      ),
                      const SizedBox(height: 16),
                      const Text(
                        'لا توجد طلبات حالياً',
                        style: TextStyle(fontSize: 18, color: Colors.grey),
                      ),
                      const SizedBox(height: 24),
                      ElevatedButton.icon(
                        onPressed: _sendTestRequest,
                        icon: const Icon(Icons.send),
                        label: const Text('إرسال طلب تجريبي'),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: Colors.orange,
                          foregroundColor: Colors.white,
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            )
          : RefreshIndicator(
              onRefresh: _loadProviderRequests,
              child: ListView.builder(
                padding: const EdgeInsets.all(16),
                itemCount: _providerRequests.length,
                itemBuilder: (context, index) {
                  final request = _providerRequests[index];
                  if (request['type'] == 'new_request') {
                    return _buildNewRequestCard(request['requestData']);
                  } else if (request['type'] == 'registered_provider') {
                    return _buildProviderRequestCard(request);
                  } else if (request['type'] == 'new_item_request') {
                    return _buildNewItemRequestCard(request);
                  }
                  return const SizedBox.shrink();
                },
              ),
            ),
    );
  }

  Widget _buildNewRequestCard(Map<String, dynamic> requestData) {
    // التحقق من نوع الطلب (قاعة أعراس أم عادي)
    final isHallProvider =
        requestData['isHallProvider'] == true ||
        requestData['serviceType'] == 'قاعات اعراس' ||
        requestData['serviceName'] == 'قاعات اعراس';

    // استخراج العناصر من بيانات الطلب
    final items = requestData['items'] as List<dynamic>? ?? [];

    // اسم الخدمة هو الاسم التجاري المعروض
    final businessName = isHallProvider
        ? (requestData['hallName'] ??
              requestData['serviceName'] ??
              'قاعة أعراس')
        : (requestData['serviceName'] ??
              requestData['serviceType'] ??
              requestData['providerName'] ??
              requestData['userName'] ??
              'مزود خدمة');
    final providerPhone =
        requestData['userPhone'] ??
        requestData['phone'] ??
        requestData['providerPhone'] ??
        requestData['providerPhone'] ??
        'غير محدد';
    // اسم المستخدم الحقيقي (ليس الاسم التجاري)
    final actualUserName =
        requestData['userName'] ?? requestData['name'] ?? providerPhone;
    // المحافظة
    final userGovernorate =
        requestData['userGovernorate'] ??
        requestData['governorate'] ??
        requestData['city'] ??
        'غير محدد';
    // المنطقة
    final userArea =
        requestData['userArea'] ??
        requestData['area'] ??
        requestData['serviceArea'] ??
        'غير محدد';
    final serviceName =
        requestData['serviceType'] ?? requestData['serviceName'] ?? 'غير محدد';

    // إحصائيات العناصر (للقاعات، العناصر هي الخدمات الضمنية)
    final totalItems = isHallProvider
        ? (requestData['includedServices'] as List<dynamic>?)?.length ?? 0
        : items.length;

    // تحديد ما إذا كان الطلب جديداً (خلال آخر 24 ساعة)
    bool isNew = false;
    DateTime? requestDate;
    if (requestData['submittedAt'] != null) {
      requestDate = (requestData['submittedAt'] as Timestamp).toDate();
    } else if (requestData['createdAt'] != null) {
      requestDate = (requestData['createdAt'] as Timestamp).toDate();
    }

    if (requestDate != null) {
      final now = DateTime.now();
      final difference = now.difference(requestDate);
      isNew = difference.inHours < 24;
    }

    final isRegisteredProvider =
        requestData['isRegisteredProvider'] == true ||
        requestData['published'] == true ||
        requestData['isPublished'] == true ||
        requestData['status'] == 'approved';

    return Card(
      margin: const EdgeInsets.only(bottom: 16),
      elevation: 4,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      child: ExpansionTile(
        tilePadding: const EdgeInsets.all(16),
        childrenPadding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
        leading: Container(
          padding: const EdgeInsets.all(12),
          decoration: BoxDecoration(
            color: Colors.orange.withOpacity(0.1),
            borderRadius: BorderRadius.circular(12),
          ),
          child: Stack(
            clipBehavior: Clip.none,
            children: [
              const Icon(
                Icons.assignment_outlined,
                color: Colors.orange,
                size: 24,
              ),
              if (isNew)
                Positioned(
                  top: -4,
                  right: -4,
                  child: Container(
                    width: 12,
                    height: 12,
                    decoration: const BoxDecoration(
                      color: Colors.red,
                      shape: BoxShape.circle,
                    ),
                  ),
                ),
            ],
          ),
        ),
        title: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Expanded(
                  child: Text(
                    '$businessName (طلب جديد)',
                    style: const TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                      color: Color(0xFF2D3748),
                    ),
                  ),
                ),
                if (isNew)
                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: 8,
                      vertical: 4,
                    ),
                    decoration: BoxDecoration(
                      color: Colors.red,
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: const Text(
                      'جديد',
                      style: TextStyle(
                        color: Colors.white,
                        fontSize: 12,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                const SizedBox(width: 8),
                if (isRegisteredProvider)
                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: 8,
                      vertical: 4,
                    ),
                    decoration: BoxDecoration(
                      color: const Color(0xFF10B981),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: const Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Icon(Icons.verified, size: 14, color: Colors.white),
                        SizedBox(width: 4),
                        Text(
                          'مزود مسجل',
                          style: TextStyle(
                            color: Colors.white,
                            fontSize: 12,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ],
                    ),
                  ),
              ],
            ),
          ],
        ),
        subtitle: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const SizedBox(height: 8),
            Text(
              'خدمة: $serviceName',
              style: const TextStyle(fontSize: 14, color: Colors.grey),
            ),
            const SizedBox(height: 4),
            Text(
              'الهاتف: $providerPhone',
              style: const TextStyle(fontSize: 14, color: Colors.grey),
            ),
            const SizedBox(height: 8),
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
              decoration: BoxDecoration(
                color: Colors.orange.withOpacity(0.1),
                borderRadius: BorderRadius.circular(12),
              ),
              child: Text(
                'طلب جديد - عدد العناصر: $totalItems',
                style: const TextStyle(
                  color: Colors.orange,
                  fontSize: 12,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ],
        ),
        children: [
          const SizedBox(height: 12),
          // معلومات أساسية عن الطلب
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: Colors.orange.withOpacity(0.05),
              borderRadius: BorderRadius.circular(12),
              border: Border.all(color: Colors.orange.withOpacity(0.3)),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    const Icon(
                      Icons.info_outline,
                      color: Colors.orange,
                      size: 20,
                    ),
                    const SizedBox(width: 8),
                    const Text(
                      'معلومات الطلب',
                      style: TextStyle(
                        fontSize: 16,
                        fontWeight: FontWeight.bold,
                        color: Color(0xFF2D3748),
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 12),
                // صورة الخدمة
                if (requestData['serviceImage'] != null ||
                    requestData['serviceImageUrl'] != null ||
                    requestData['imageUrl'] != null)
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'صورة الخدمة:',
                        style: TextStyle(
                          fontWeight: FontWeight.bold,
                          color: Color(0xFF2D3748),
                        ),
                      ),
                      const SizedBox(height: 8),
                      ClipRRect(
                        borderRadius: BorderRadius.circular(12),
                        child: Image.network(
                          requestData['serviceImage'] ??
                              requestData['serviceImageUrl'] ??
                              requestData['imageUrl'] ??
                              '',
                          height: 200,
                          width: double.infinity,
                          fit: BoxFit.cover,
                          errorBuilder: (context, error, stackTrace) {
                            return Container(
                              height: 200,
                              width: double.infinity,
                              color: Colors.grey[200],
                              child: const Column(
                                mainAxisAlignment: MainAxisAlignment.center,
                                children: [
                                  Icon(
                                    Icons.broken_image,
                                    size: 50,
                                    color: Colors.grey,
                                  ),
                                  SizedBox(height: 8),
                                  Text(
                                    'لا توجد صورة',
                                    style: TextStyle(color: Colors.grey),
                                  ),
                                ],
                              ),
                            );
                          },
                        ),
                      ),
                      const SizedBox(height: 12),
                    ],
                  ),
                _buildInfoRow('الاسم التجاري', businessName),
                _buildInfoRow('اسم المستخدم', actualUserName),
                _buildInfoRow('نوع الخدمة', serviceName),
                _buildInfoRow('رقم الهاتف', providerPhone),
                _buildInfoRow('المحافظة', userGovernorate),
                _buildInfoRow('المنطقة', userArea),
                if (requestData['creditCard'] != null &&
                    requestData['creditCard'].toString().isNotEmpty)
                  _buildInfoRow(
                    'رقم بطاقة الائتمان',
                    requestData['creditCard'],
                  ),
                const SizedBox(height: 12),
                // زر عرض الموقع على الخريطة
                ElevatedButton.icon(
                  onPressed: () {
                    double? lat;
                    double? lng;

                    // محاولة الحصول على الموقع من عدة حقول محتملة
                    if (requestData['location'] != null) {
                      final location = requestData['location'];
                      if (location is GeoPoint) {
                        lat = location.latitude;
                        lng = location.longitude;
                      } else if (location is Map) {
                        lat = location['latitude'];
                        lng = location['longitude'];
                      }
                    }

                    if (lat == null || lng == null) {
                      lat = requestData['latitude'];
                      lng = requestData['longitude'];
                    }

                    if (lat != null && lng != null) {
                      _showLocationOnMap(context, lat, lng, businessName);
                    } else {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('الموقع غير متوفر في هذا الطلب'),
                        ),
                      );
                    }
                  },
                  icon: const Icon(Icons.map),
                  label: const Text('عرض الموقع على الخريطة'),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF10B981),
                    foregroundColor: Colors.white,
                    minimumSize: const Size(double.infinity, 45),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(12),
                    ),
                  ),
                ),
              ],
            ),
          ),

          const SizedBox(height: 16),

          if (isHallProvider)
            // عرض بيانات قاعة الأعراس
            _buildHallProviderDetails(requestData)
          else if (items.isEmpty &&
              (requestData['existingItems'] == null ||
                  (requestData['existingItems'] as List).isEmpty))
            Container(
              padding: const EdgeInsets.all(16),
              child: const Text(
                'لا توجد عناصر في هذا الطلب',
                style: TextStyle(color: Colors.grey),
              ),
            )
          else
            Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                // عرض العناصر القديمة إذا كان المزود مسجلاً
                if (requestData['existingItems'] != null &&
                    (requestData['existingItems'] as List).isNotEmpty) ...[
                  Row(
                    children: [
                      const Icon(
                        Icons.inventory_2_outlined,
                        color: Color(0xFF10B981),
                        size: 20,
                      ),
                      const SizedBox(width: 8),
                      const Text(
                        'العناصر الموجودة (قديمة)',
                        style: TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.bold,
                          color: Color(0xFF10B981),
                        ),
                      ),
                      const Spacer(),
                      Container(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 8,
                          vertical: 4,
                        ),
                        decoration: BoxDecoration(
                          color: const Color(0xFF10B981).withOpacity(0.1),
                          borderRadius: BorderRadius.circular(12),
                        ),
                        child: Text(
                          '${(requestData['existingItems'] as List).length} عنصر قديم',
                          style: const TextStyle(
                            color: Color(0xFF10B981),
                            fontSize: 12,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 12),
                  ...(requestData['existingItems'] as List).asMap().entries.map(
                    (entry) {
                      final index = entry.key;
                      final item = entry.value as Map<String, dynamic>;
                      return _buildExistingItemCard(item, index);
                    },
                  ).toList(),
                  const SizedBox(height: 24),
                ],
                // عرض العناصر الجديدة
                if (items.isNotEmpty) ...[
                  Row(
                    children: [
                      const Icon(
                        Icons.inventory,
                        color: Color(0xFF1E88E5),
                        size: 20,
                      ),
                      const SizedBox(width: 8),
                      Text(
                        requestData['existingItems'] != null &&
                                (requestData['existingItems'] as List)
                                    .isNotEmpty
                            ? 'العناصر الجديدة المطلوب إضافتها'
                            : 'عناصر الطلب',
                        style: const TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.bold,
                          color: Color(0xFF1E88E5),
                        ),
                      ),
                      const Spacer(),
                      Container(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 8,
                          vertical: 4,
                        ),
                        decoration: BoxDecoration(
                          color: const Color(0xFF1E88E5).withOpacity(0.1),
                          borderRadius: BorderRadius.circular(12),
                        ),
                        child: Text(
                          '$totalItems عنصر جديد',
                          style: const TextStyle(
                            color: Color(0xFF1E88E5),
                            fontSize: 12,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 12),
                  ...items.asMap().entries.map((entry) {
                    final index = entry.key;
                    final item = entry.value as Map<String, dynamic>;
                    return _buildNewRequestItemCard(item, index, requestData);
                  }).toList(),
                ],
              ],
            ),

          const SizedBox(height: 16),

          // أزرار الإجراءات الرئيسية
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: Colors.grey.withOpacity(0.05),
              borderRadius: BorderRadius.circular(12),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    const Icon(
                      Icons.admin_panel_settings,
                      color: Color(0xFF1E88E5),
                      size: 20,
                    ),
                    const SizedBox(width: 8),
                    const Text(
                      'إجراءات الإدارة',
                      style: TextStyle(
                        fontSize: 16,
                        fontWeight: FontWeight.bold,
                        color: Color(0xFF2D3748),
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 12),
                Row(
                  children: [
                    Expanded(
                      child: ElevatedButton.icon(
                        onPressed: () => _approveNewRequest(requestData),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: const Color(0xFF10B981),
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(vertical: 12),
                        ),
                        icon: const Icon(Icons.check_circle, size: 20),
                        label: const Text('موافقة على الطلب'),
                      ),
                    ),
                    const SizedBox(width: 8),
                    Expanded(
                      child: ElevatedButton.icon(
                        onPressed: () => _rejectNewRequest(requestData),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: Colors.red,
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(vertical: 12),
                        ),
                        icon: const Icon(Icons.cancel, size: 20),
                        label: const Text('رفض الطلب'),
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 8),
                SizedBox(
                  width: double.infinity,
                  child: ElevatedButton.icon(
                    onPressed: () => _contactProvider(requestData),
                    style: ElevatedButton.styleFrom(
                      backgroundColor: const Color(0xFF1E88E5),
                      foregroundColor: Colors.white,
                      padding: const EdgeInsets.symmetric(vertical: 12),
                    ),
                    icon: const Icon(Icons.chat, size: 20),
                    label: const Text('محادثة مزود الخدمة'),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildNewRequestItemCard(
    Map<String, dynamic> item,
    int index,
    Map<String, dynamic> requestData,
  ) {
    return Container(
      margin: const EdgeInsets.only(bottom: 12),
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: Colors.grey.withOpacity(0.3)),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withOpacity(0.05),
            blurRadius: 4,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Container(
                padding: const EdgeInsets.all(8),
                decoration: BoxDecoration(
                  color: const Color(0xFF1E88E5).withOpacity(0.1),
                  borderRadius: BorderRadius.circular(8),
                ),
                child: Text(
                  '${index + 1}',
                  style: const TextStyle(
                    color: Color(0xFF1E88E5),
                    fontWeight: FontWeight.bold,
                    fontSize: 16,
                  ),
                ),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: Text(
                  item['name'] ?? 'عنصر غير محدد',
                  style: const TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                    color: Color(0xFF2D3748),
                  ),
                ),
              ),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                decoration: BoxDecoration(
                  color: Colors.orange.withOpacity(0.1),
                  borderRadius: BorderRadius.circular(8),
                ),
                child: const Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Icon(Icons.schedule, size: 14, color: Colors.orange),
                    SizedBox(width: 4),
                    Text(
                      'في انتظار المراجعة',
                      style: TextStyle(
                        color: Colors.orange,
                        fontSize: 12,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
          const SizedBox(height: 12),

          // تفاصيل العنصر
          if (item['details'] != null && item['details'].toString().isNotEmpty)
            Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: Colors.grey.withOpacity(0.05),
                borderRadius: BorderRadius.circular(8),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Row(
                    children: [
                      Icon(Icons.description, size: 16, color: Colors.grey),
                      SizedBox(width: 8),
                      Text(
                        'التفاصيل:',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.bold,
                          color: Colors.grey,
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 8),
                  Text(
                    item['details'].toString(),
                    style: const TextStyle(
                      fontSize: 14,
                      color: Color(0xFF2D3748),
                    ),
                  ),
                ],
              ),
            ),

          const SizedBox(height: 12),

          // معلومات السعر والسعة
          Row(
            children: [
              if (item['price'] != null)
                Expanded(
                  child: Container(
                    padding: const EdgeInsets.all(12),
                    decoration: BoxDecoration(
                      color: const Color(0xFF10B981).withOpacity(0.1),
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        const Row(
                          children: [
                            Icon(
                              Icons.attach_money,
                              size: 16,
                              color: Color(0xFF10B981),
                            ),
                            SizedBox(width: 8),
                            Text(
                              'السعر:',
                              style: TextStyle(
                                fontSize: 12,
                                color: Colors.grey,
                              ),
                            ),
                          ],
                        ),
                        const SizedBox(height: 4),
                        Text(
                          '${item['price']} دينار عراقي',
                          style: const TextStyle(
                            fontSize: 16,
                            fontWeight: FontWeight.bold,
                            color: Color(0xFF10B981),
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              if (item['price'] != null && item['capacity'] != null)
                const SizedBox(width: 8),
              if (item['capacity'] != null)
                Expanded(
                  child: Container(
                    padding: const EdgeInsets.all(12),
                    decoration: BoxDecoration(
                      color: const Color(0xFF1E88E5).withOpacity(0.1),
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        const Row(
                          children: [
                            Icon(
                              Icons.people,
                              size: 16,
                              color: Color(0xFF1E88E5),
                            ),
                            SizedBox(width: 8),
                            Text(
                              'السعة:',
                              style: TextStyle(
                                fontSize: 12,
                                color: Colors.grey,
                              ),
                            ),
                          ],
                        ),
                        const SizedBox(height: 4),
                        Text(
                          item['capacity'].toString(),
                          style: const TextStyle(
                            fontSize: 16,
                            fontWeight: FontWeight.bold,
                            color: Color(0xFF1E88E5),
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
            ],
          ),

          // عرض الصور إن وجدت
          if (item['imageUrls'] != null &&
              (item['imageUrls'] as List).isNotEmpty) ...[
            const SizedBox(height: 12),
            const Row(
              children: [
                Icon(Icons.image, size: 16, color: Colors.grey),
                SizedBox(width: 8),
                Text(
                  'الصور المرفقة:',
                  style: TextStyle(
                    fontSize: 14,
                    fontWeight: FontWeight.bold,
                    color: Colors.grey,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 8),
            SizedBox(
              height: 80,
              child: ListView.builder(
                scrollDirection: Axis.horizontal,
                itemCount: (item['imageUrls'] as List).length,
                itemBuilder: (context, imgIndex) {
                  return Container(
                    width: 80,
                    height: 80,
                    margin: const EdgeInsets.only(right: 8),
                    decoration: BoxDecoration(
                      borderRadius: BorderRadius.circular(8),
                      border: Border.all(color: Colors.grey.withOpacity(0.3)),
                    ),
                    child: ClipRRect(
                      borderRadius: BorderRadius.circular(8),
                      child: Image.network(
                        (item['imageUrls'] as List)[imgIndex],
                        fit: BoxFit.cover,
                        errorBuilder: (context, error, stackTrace) {
                          return Container(
                            color: Colors.grey[200],
                            child: const Icon(
                              Icons.broken_image,
                              color: Colors.grey,
                            ),
                          );
                        },
                      ),
                    ),
                  );
                },
              ),
            ),
          ],
        ],
      ),
    );
  }

  Widget _buildProviderRequestCard(Map<String, dynamic> request) {
    final providerData = request['providerData'] as Map<String, dynamic>;
    final items = request['items'] as List<Map<String, dynamic>>;

    // إحصائيات العناصر
    final pendingItems = items
        .where((item) => item['status'] == 'pending')
        .length;
    final approvedItems = items
        .where((item) => item['status'] == 'approved')
        .length;
    final rejectedItems = items
        .where((item) => item['status'] == 'rejected')
        .length;

    return Card(
      margin: const EdgeInsets.only(bottom: 16),
      elevation: 4,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      child: ExpansionTile(
        tilePadding: const EdgeInsets.all(16),
        childrenPadding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
        leading: Container(
          padding: const EdgeInsets.all(12),
          decoration: BoxDecoration(
            color: const Color(0xFF1E88E5).withOpacity(0.1),
            borderRadius: BorderRadius.circular(12),
          ),
          child: const Icon(Icons.business, color: Color(0xFF1E88E5), size: 24),
        ),
        title: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              providerData['serviceName'] ??
                  providerData['providerName'] ??
                  'مزود خدمة',
              style: const TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.bold,
                color: Color(0xFF2D3748),
              ),
            ),
            const SizedBox(height: 6),
            // عرض اسم الخدمة بشكل واضح
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
              decoration: BoxDecoration(
                color: const Color(0xFF10B981).withOpacity(0.15),
                borderRadius: BorderRadius.circular(16),
                border: Border.all(
                  color: const Color(0xFF10B981).withOpacity(0.3),
                ),
              ),
              child: Row(
                mainAxisSize: MainAxisSize.min,
                children: [
                  const Icon(
                    Icons.business,
                    size: 16,
                    color: Color(0xFF10B981),
                  ),
                  const SizedBox(width: 6),
                  Text(
                    'خدمة: ${providerData['serviceName'] ?? 'غير محدد'}',
                    style: const TextStyle(
                      fontSize: 14,
                      color: Color(0xFF10B981),
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 4),
            Row(
              children: [
                if (providerData['governorate'] != null)
                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: 8,
                      vertical: 4,
                    ),
                    decoration: BoxDecoration(
                      color: Colors.orange.withOpacity(0.1),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        const Icon(
                          Icons.location_on,
                          size: 12,
                          color: Colors.orange,
                        ),
                        const SizedBox(width: 4),
                        Text(
                          providerData['governorate'],
                          style: const TextStyle(
                            fontSize: 12,
                            color: Colors.orange,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                      ],
                    ),
                  ),
                const SizedBox(width: 8),
                if (providerData['area'] != null)
                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: 8,
                      vertical: 4,
                    ),
                    decoration: BoxDecoration(
                      color: Colors.blue.withOpacity(0.1),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Text(
                      providerData['area'],
                      style: const TextStyle(
                        fontSize: 12,
                        color: Colors.blue,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ),
              ],
            ),
          ],
        ),
        subtitle: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const SizedBox(height: 8),
            // معلومات الخدمة والتواصل والموقع
            Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: Colors.grey[50],
                borderRadius: BorderRadius.circular(8),
                border: Border.all(color: Colors.grey[200]!),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  // عرض اسم الخدمة مرة أخرى في التفاصيل
                  Row(
                    children: [
                      const Icon(
                        Icons.work,
                        size: 16,
                        color: Color(0xFF10B981),
                      ),
                      const SizedBox(width: 8),
                      Expanded(
                        child: Text(
                          'نوع الخدمة: ${providerData['serviceName'] ?? 'غير محدد'}',
                          style: const TextStyle(
                            fontSize: 14,
                            fontWeight: FontWeight.bold,
                            color: Color(0xFF10B981),
                          ),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 8),
                  Row(
                    children: [
                      const Icon(Icons.phone, size: 16, color: Colors.grey),
                      const SizedBox(width: 8),
                      Text(
                        providerData['providerPhone'] ?? 'غير محدد',
                        style: const TextStyle(
                          fontSize: 14,
                          color: Colors.grey,
                        ),
                      ),
                      const Spacer(),
                      if (providerData['area'] != null) ...[
                        const Icon(
                          Icons.location_on,
                          size: 16,
                          color: Colors.grey,
                        ),
                        const SizedBox(width: 4),
                        Text(
                          providerData['area'],
                          style: const TextStyle(
                            fontSize: 14,
                            color: Colors.grey,
                          ),
                        ),
                      ],
                    ],
                  ),
                  if (providerData['createdAt'] != null) ...[
                    const SizedBox(height: 8),
                    Row(
                      children: [
                        const Icon(
                          Icons.calendar_today,
                          size: 16,
                          color: Colors.grey,
                        ),
                        const SizedBox(width: 8),
                        Text(
                          'تاريخ التسجيل: ${_formatDate(providerData['createdAt'])}',
                          style: const TextStyle(
                            fontSize: 14,
                            color: Colors.grey,
                          ),
                        ),
                      ],
                    ),
                  ],
                ],
              ),
            ),
            const SizedBox(height: 12),
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceEvenly,
              children: [
                _buildStatusChip('قيد المراجعة', pendingItems, Colors.orange),
                _buildStatusChip(
                  'معتمد',
                  approvedItems,
                  const Color(0xFF10B981),
                ),
                _buildStatusChip('مرفوض', rejectedItems, Colors.red),
              ],
            ),
          ],
        ),
        children: [
          if (items.isEmpty)
            const Padding(
              padding: EdgeInsets.all(16),
              child: Text(
                'لا توجد عناصر لهذا المزود',
                style: TextStyle(color: Colors.grey),
              ),
            )
          else
            Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text(
                  'عناصر الخدمة:',
                  style: TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                    color: Color(0xFF2D3748),
                  ),
                ),
                const SizedBox(height: 12),
                ...items.map((item) => _buildItemCard(item)).toList(),
              ],
            ),
        ],
      ),
    );
  }

  String _formatDate(dynamic timestamp) {
    if (timestamp == null) return 'غير محدد';

    try {
      DateTime date;
      if (timestamp is Timestamp) {
        date = timestamp.toDate();
      } else if (timestamp is String) {
        date = DateTime.parse(timestamp);
      } else {
        return 'تاريخ غير صالح';
      }

      return '${date.day}/${date.month}/${date.year}';
    } catch (e) {
      print('Error formatting date: $e');
      return 'تاريخ غير صالح';
    }
  }

  Widget _buildStatusChip(String label, int count, Color color) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
      decoration: BoxDecoration(
        color: color.withOpacity(0.1),
        borderRadius: BorderRadius.circular(12),
      ),
      child: Text(
        '$label ($count)',
        style: TextStyle(
          color: color,
          fontSize: 12,
          fontWeight: FontWeight.bold,
        ),
      ),
    );
  }

  Widget _buildItemCard(Map<String, dynamic> item) {
    final String status = item['status'] ?? 'pending';
    Color statusColor;
    String statusText;
    IconData statusIcon;

    switch (status) {
      case 'approved':
        statusColor = const Color(0xFF10B981);
        statusText = 'معتمد';
        statusIcon = Icons.check_circle;
        break;
      case 'rejected':
        statusColor = Colors.red;
        statusText = 'مرفوض';
        statusIcon = Icons.cancel;
        break;
      default:
        statusColor = Colors.orange;
        statusText = 'قيد المراجعة';
        statusIcon = Icons.hourglass_empty;
    }

    return Container(
      margin: const EdgeInsets.only(bottom: 12),
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.grey[50],
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: statusColor.withOpacity(0.3)),
      ),
      child: InkWell(
        onTap: () => _showItemDetailsDialog(item),
        borderRadius: BorderRadius.circular(12),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Expanded(
                  child: Text(
                    item['name'] ?? 'عنصر غير محدد',
                    style: const TextStyle(
                      fontSize: 16,
                      fontWeight: FontWeight.bold,
                      color: Color(0xFF2D3748),
                    ),
                  ),
                ),
                Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 8,
                    vertical: 4,
                  ),
                  decoration: BoxDecoration(
                    color: statusColor.withOpacity(0.1),
                    borderRadius: BorderRadius.circular(8),
                  ),
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(statusIcon, size: 14, color: statusColor),
                      const SizedBox(width: 4),
                      Text(
                        statusText,
                        style: TextStyle(
                          color: statusColor,
                          fontSize: 12,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),
            const SizedBox(height: 8),
            Text(
              'السعر: ${item['price'] ?? 'غير محدد'} دينار عراقي',
              style: const TextStyle(
                fontSize: 14,
                fontWeight: FontWeight.bold,
                color: Color(0xFF10B981),
              ),
            ),
            if (item['details'] != null && item['details'].isNotEmpty) ...[
              const SizedBox(height: 8),
              Text(
                item['details'],
                style: const TextStyle(fontSize: 14, color: Colors.grey),
                maxLines: 2,
                overflow: TextOverflow.ellipsis,
              ),
            ],
            const SizedBox(height: 8),
            Row(
              mainAxisAlignment: MainAxisAlignment.end,
              children: [
                const Icon(Icons.touch_app, size: 16, color: Colors.grey),
                const SizedBox(width: 4),
                const Text(
                  'اضغط للمراجعة',
                  style: TextStyle(fontSize: 12, color: Colors.grey),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

