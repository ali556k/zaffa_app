  Widget _buildStatusIndicator(String status) {
    Color color;
    String text;
    IconData icon;

    switch (status) {
      case 'approved':
        color = const Color(0xFF10B981);
        text = 'معتمد';
        icon = Icons.check_circle;
        break;
      case 'rejected':
        color = Colors.red;
        text = 'مرفوض';
        icon = Icons.cancel;
        break;
      default:
        color = Colors.orange;
        text = 'قيد المراجعة';
        icon = Icons.hourglass_empty;
    }

    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
      decoration: BoxDecoration(
        color: color.withOpacity(0.1),
        borderRadius: BorderRadius.circular(8),
        border: Border.all(color: color.withOpacity(0.3)),
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(icon, size: 20, color: color),
          const SizedBox(width: 8),
          Text(
            text,
            style: TextStyle(color: color, fontWeight: FontWeight.bold),
          ),
        ],
      ),
    );
  }

  // Helper method to safely parse price from different data types
  num _parsePrice(dynamic priceValue) {
    if (priceValue == null) return 0;
    if (priceValue is num) return priceValue;
    if (priceValue is String) {
      try {
        return num.parse(priceValue);
      } catch (e) {
        return 0;
      }
    }
    return 0;
  }

  Future<void> _approveItem(Map<String, dynamic> item) async {
    try {
      final providerId = item['providerId'];

      // الحصول على معلومات المزود
      final providerDoc = await FirebaseFirestore.instance
          .collection('users')
          .doc(providerId)
          .get();

      if (!providerDoc.exists) {
        throw Exception('بيانات المزود غير موجودة');
      }

      final providerData = providerDoc.data()!;
      final serviceName = providerData['serviceName'] as String?;

      if (serviceName != null) {
        final category = _getServiceCategory(serviceName);

        // نشر العنصر مباشرة
        final publishedItemRef = FirebaseFirestore.instance
            .collection('published_items')
            .doc();

        await publishedItemRef.set({
          'itemId': publishedItemRef.id,
          'providerId': providerId,
          'providerName':
              providerData['providerName'] ??
              providerData['displayName'] ??
              'مزود خدمة',
          'category': category,
          'serviceName': serviceName,
          'name': item['name'] ?? '',
          'details': item['details'] ?? '',
          'price': _parsePrice(item['price']),
          'images': item['images'] ?? item['imageUrls'] ?? [],
          'imageUrl': _getFirstImage(item['images'] ?? item['imageUrls'] ?? []),
          'isActive': true,
          'bookedDates': <String>[],
          'totalBookings': 0,
          'rating': 0.0,
          'reviewCount': 0,
          'publishedAt': FieldValue.serverTimestamp(),
          'createdAt': FieldValue.serverTimestamp(),
        });

        print('✅ تم نشر العنصر: ${item['name']}');
      }

      // تحديث العنصر الأصلي
      await FirebaseFirestore.instance
          .collection('provider_items')
          .doc(item['id'])
          .update({
            'status': 'active', // تغيير من approved إلى active
            'approvedAt': FieldValue.serverTimestamp(),
            'rejectedAt': null,
            'adminComments': 'تمت الموافقة من قبل الإدارة',
          });

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('✅ تمت الموافقة ونشر العنصر بنجاح!'),
          backgroundColor: Color(0xFF10B981),
        ),
      );

      _loadProviderRequests(); // إعادة تحميل البيانات
    } catch (e) {
      print('❌ خطأ في الموافقة على العنصر: $e');
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('حدث خطأ أثناء الموافقة: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Future<void> _rejectItem(Map<String, dynamic> item) async {
    final TextEditingController commentController = TextEditingController();

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('رفض العنصر'),
        content: TextField(
          controller: commentController,
          maxLines: 3,
          decoration: const InputDecoration(
            labelText: 'سبب الرفض',
            border: OutlineInputBorder(),
            hintText: 'أدخل سبب رفض هذا العنصر...',
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('cancel'.tr()),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: Colors.red),
            onPressed: () async {
              try {
                await FirebaseFirestore.instance
                    .collection('provider_items')
                    .doc(item['id'])
                    .update({
                      'status': 'rejected',
                      'rejectedAt': FieldValue.serverTimestamp(),
                      'approvedAt': null,
                      'adminComments': commentController.text.trim(),
                    });

                Navigator.pop(context);
                ScaffoldMessenger.of(
                  context,
                ).showSnackBar(const SnackBar(content: Text('تم رفض العنصر')));

                _loadProviderRequests(); // إعادة تحميل البيانات
              } catch (e) {
                ScaffoldMessenger.of(
                  context,
                ).showSnackBar(SnackBar(content: Text('خطأ: $e')));
              }
            },
            child: const Text('reject'.tr()),
          ),
        ],
      ),
    );
  }

  Future<void> _approveNewRequest(Map<String, dynamic> requestData) async {
    try {
      final requestId = requestData['requestId'];
      // استخراج معرف المزود مع إعطاء الأولوية للحقل الصحيح
      final providerId =
          requestData['providerId'] ??
          requestData['providerPhone'] ??
          requestData['userPhone'] ??
          requestData['phone'];
      final providerName =
          requestData['providerName'] ??
          requestData['userName'] ??
          requestData['name'] ??
          requestData['displayName'];
      final serviceName =
          requestData['serviceType'] ?? requestData['serviceName'];
      final items = requestData['items'] as List<dynamic>? ?? [];

      print('🔄 بدء عملية موافقة المزود: $providerId');
      print('📋 بيانات الطلب الكاملة: $requestData');
      print('📝 اسم المزود: $providerName');
      print('🔧 نوع الخدمة: $serviceName');
      print('📦 عدد العناصر: ${items.length}');

      // تحديد فئة الخدمة
      String category = _getServiceCategory(serviceName);
      String arabicCollection = _getArabicCollection(serviceName);
      print('🏷️ فئة الخدمة: $category');
      print('🏷️ مجموعة الخدمة بالعربي: $arabicCollection');

      // تحذير في حال التصنيف خاطئ
      if (category == 'other' &&
          serviceName != null &&
          !serviceName.toLowerCase().contains('عامة') &&
          !serviceName.toLowerCase().contains('general')) {
        print(
          '⚠️ تحذير: الخدمة "$serviceName" تم تصنيفها كـ "other" - قد تكون هناك مشكلة في التصنيف!',
        );
      }

      // التحقق من كون الخدمة قاعة أعراس
      bool isHallProvider =
          serviceName == 'قاعات اعراس' ||
          serviceName == 'قاعة عرس' ||
          serviceName == 'hall' ||
          requestData['isHallProvider'] == true;

      print('🏛️ هل هذا مزود قاعة أعراس؟ $isHallProvider');

      // التأكد من وجود البيانات الأساسية
      if (providerId == null || providerId.isEmpty) {
        throw Exception('معرف المزود مفقود');
      }

      // حذف أي مزود سابق بنفس المعرف لتجنب الازدواجية
      try {
        await FirebaseFirestore.instance
            .collection('published_providers')
            .doc(providerId)
            .delete();
        print('🗑️ تم حذف المزود السابق بالمعرف: $providerId');
      } catch (e) {
        print('ℹ️ لا يوجد مزود سابق بهذا المعرف: $e');
      }

      // تحديث حالة الطلب إلى معتمد
      await FirebaseFirestore.instance
          .collection('provider_requests')
          .doc(requestId)
          .update({
            'status': 'approved',
            'approvedAt': FieldValue.serverTimestamp(),
            'adminComments': 'تمت الموافقة على الطلب من قبل الإدارة',
          });

      // تحديث حالة الحساب في provider_services
      await FirebaseFirestore.instance
          .collection('provider_services')
          .doc(providerId)
          .update({
            'status': 'approved',
            'approvedAt': FieldValue.serverTimestamp(),
          });

      // تحديث حالة الحساب في providers
      await FirebaseFirestore.instance
          .collection('providers')
          .doc(providerId)
          .update({
            'status': 'approved',
            'approvedAt': FieldValue.serverTimestamp(),
          });

      // إنشاء مزود الخدمة في القائمة المنشورة
      final providerDocRef = FirebaseFirestore.instance
          .collection('published_providers')
          .doc(providerId);

      print('📝 إنشاء مزود في published_providers مع ID: $providerId');
      print('📝 الفئة: $category');
      print('📝 اسم المزود: $providerName');

      // إعداد البيانات للحفظ
      // اسم المزود (اسم المستخدم/رقم الهاتف فقط)
      final finalProviderName =
          requestData['providerName'] ??
          requestData['userName'] ??
          requestData['phone'] ??
          requestData['name'] ??
          'مزود خدمة';
      // اسم الخدمة التجاري فقط (لا يسمح أن يكون اسم المستخدم)
      String finalServiceName = '';
      if (requestData['serviceName'] != null &&
          requestData['serviceName'].toString().trim().isNotEmpty) {
        finalServiceName = requestData['serviceName'].toString().trim();
      } else if (requestData['name'] != null &&
          requestData['name'].toString().trim().isNotEmpty) {
        finalServiceName = requestData['name'].toString().trim();
      }
      // إذا كان finalServiceName يساوي اسم المستخدم أو رقم الهاتف أو فارغ، اجعله "اسم الخدمة غير محدد"
      if (finalServiceName == requestData['userName'] ||
          finalServiceName == requestData['providerName'] ||
          finalServiceName == requestData['phone'] ||
          finalServiceName.isEmpty) {
        finalServiceName = 'اسم الخدمة غير محدد';
      }
      final finalGovernorate =
          requestData['userGovernorate'] ??
          requestData['governorate'] ??
          requestData['serviceArea'] ??
          requestData['area'] ??
          '';
      final finalArea =
          requestData['area'] ??
          requestData['serviceArea'] ??
          requestData['userGovernorate'] ??
          requestData['governorate'] ??
          '';
      final finalPhone =
          requestData['providerPhone'] ??
          requestData['userPhone'] ??
          requestData['phone'] ??
          '';

      print('🔍 البيانات النهائية:');
      print('  - الاسم: $finalProviderName');
      print('  - الخدمة: $finalServiceName');
      print('  - المحافظة: $finalGovernorate');
      print('  - المنطقة: $finalArea');
      print('  - الهاتف: $finalPhone');

      // بيانات إضافية لقاعات الأعراس
      Map<String, dynamic> providerData = {
        'providerId': providerId,
        'providerName': finalProviderName, // اسم المستخدم فقط
        'userName': requestData['userName'] ?? finalProviderName,
        'serviceName': finalServiceName, // اسم الخدمة التجاري فقط
        'name': finalServiceName,
        'serviceType': requestData['serviceType'] ?? category,
        'services':
            requestData['services'] ?? [requestData['serviceType'] ?? category],
        'category': category,
        'categoryArabic': arabicCollection,
        'phone': finalPhone,
        'userPhone': finalPhone,
        'providerPhone': finalPhone,
        'governorate': finalGovernorate,
        'userGovernorate': finalGovernorate,
        'area': finalArea,
        'userArea': finalArea,
        'location': requestData['location'] ?? '',
        'latitude': requestData['latitude'],
        'longitude': requestData['longitude'],
        // صورة الخدمة فقط (بدون أي fallback غير احترافي)
        'serviceImage':
            requestData['serviceImage'] ??
            requestData['serviceImageUrl'] ??
            requestData['profileImage'] ??
            requestData['imageUrl'] ??
            '',
        'serviceImageUrl':
            requestData['serviceImage'] ??
            requestData['serviceImageUrl'] ??
            requestData['profileImage'] ??
            requestData['imageUrl'] ??
            '',
        'profileImage':
            requestData['profileImage'] ??
            requestData['serviceImage'] ??
            requestData['imageUrl'] ??
            '',
        'imageUrl':
            requestData['imageUrl'] ??
            requestData['serviceImage'] ??
            requestData['profileImage'] ??
            '',
        'creditCard': requestData['creditCard'] ?? '',
        'accountType': requestData['accountType'] ?? 'provider',
        'description': requestData['description'] ?? '',
        'rating': 0.0,
        'reviewCount': 0,
        'totalBookings': 0,
        'isActive': true,
        'publishedAt': FieldValue.serverTimestamp(),
        'createdAt': requestData['createdAt'] ?? FieldValue.serverTimestamp(),
        'submittedAt': requestData['submittedAt'] ?? requestData['createdAt'],
      };

      // إضافة بيانات خاصة بقاعات الأعراس
      if (isHallProvider) {
        // نسخ جميع بيانات القاعة من hallData إذا كانت موجودة
        Map<String, dynamic> hallData = requestData['hallData'] ?? {};

        providerData.addAll({
          'capacity':
              hallData['capacity'] ??
              requestData['expectedCapacity'] ??
              requestData['capacity'] ??
              '300 شخص',
          'features':
              requestData['hallFeatures'] ??
              [
                'نظام صوت متطور',
                'إضاءة احترافية',
                'تكييف مركزي',
                'مواقف سيارات',
              ],
          'price':
              hallData['basePrice'] ??
              requestData['price'] ??
              requestData['basePrice'] ??
              0,
          'serviceType': 'قاعات اعراس',
          'isHallProvider': true,
          'hallName':
              hallData['hallName'] ??
              requestData['hallName'] ??
              finalProviderName,
          'basePrice': hallData['basePrice'] ?? requestData['basePrice'] ?? 0,

          // الخدمات الضمنية - هذا هو الأهم!
          'includedServices':
              hallData['includedServices'] ??
              requestData['includedServices'] ??
              [],
          'totalServices':
              hallData['totalServices'] ??
              (hallData['includedServices'] ?? []).length,
          'totalIncludedPrice': hallData['totalIncludedPrice'] ?? 0,

          // صور القاعة
          'hallImages':
              hallData['hallImages'] ?? requestData['hallImages'] ?? [],

          // نسخ hallData كاملة للحفاظ على جميع البيانات
          'hallData': hallData.isNotEmpty ? hallData : null,
        });

        print('🏛️ تمت إضافة البيانات الخاصة بقاعة الأعراس');
        print(
          '📋 عدد الخدمات الضمنية: ${(hallData['includedServices'] ?? []).length}',
        );
      }

      await providerDocRef.set(providerData, SetOptions(merge: true));

      print('✅ تم إنشاء مزود الخدمة بنجاح في published_providers');
      print('📄 معرف الوثيقة: ${providerDocRef.id}');
      print('📊 البيانات المحفوظة:');
      print('   - providerId: $providerId');
      print('   - providerName: $finalProviderName');
      print('   - category: $category');
      print('   - isHallProvider: $isHallProvider');
      print('   - isActive: true');

      // التحقق من حفظ البيانات
      final savedDoc = await providerDocRef.get();
      if (savedDoc.exists) {
        print('✅ تم التحقق: الوثيقة موجودة في published_providers');
        print('   - البيانات المحفوظة: ${savedDoc.data()}');
      } else {
        print('❌ خطأ: الوثيقة غير موجودة بعد الحفظ!');
      }

      // نشر العناصر
      int publishedItemsCount = 0;

      if (isHallProvider) {
        // نشر قاعة الأعراس في مجموعة hall
        print('🏛️ نشر قاعة الأعراس في مجموعة hall...');

        Map<String, dynamic> hallData = requestData['hallData'] ?? {};
        final hallDocRef = FirebaseFirestore.instance.collection('hall').doc();

        final hallPayload = {
          'id': hallDocRef.id,
          'providerId': providerId,
          'providerName': finalProviderName,
          'providerPhone': finalPhone,
          'serviceType': 'قاعات اعراس',
          'serviceName': 'قاعات اعراس',
          'hallName':
              hallData['hallName'] ??
              requestData['hallName'] ??
              finalProviderName,
          'name':
              hallData['hallName'] ??
              requestData['hallName'] ??
              finalProviderName,
          'description':
              hallData['description'] ?? requestData['description'] ?? '',
          'details':
              hallData['description'] ?? requestData['description'] ?? '',
          'capacity': hallData['capacity'] ?? requestData['capacity'] ?? '300',
          'basePrice': hallData['basePrice'] ?? requestData['basePrice'] ?? 0,
          'price': hallData['basePrice'] ?? requestData['basePrice'] ?? 0,
          'location': requestData['location'] ?? '',
          'governorate': finalGovernorate,
          'area': finalArea,
          'imageUrls':
              hallData['hallImages'] ?? requestData['hallImages'] ?? [],
          'imageUrl': _getFirstImage(
            hallData['hallImages'] ?? requestData['hallImages'] ?? [],
          ),
          'includedServices':
              hallData['includedServices'] ??
              requestData['includedServices'] ??
              [],
          'totalServices':
              (hallData['includedServices'] ??
                      requestData['includedServices'] ??
                      [])
                  .length,
          'totalIncludedPrice':
              hallData['totalIncludedPrice'] ??
              requestData['totalIncludedPrice'] ??
              0,
          'isHallProvider': true,
          'isActive': true,
          'status': 'approved',
          'bookedDates': <String>[],
          'totalBookings': 0,
          'rating': 0.0,
          'reviewCount': 0,
          'publishedAt': FieldValue.serverTimestamp(),
          'createdAt': FieldValue.serverTimestamp(),
          'approvedAt': FieldValue.serverTimestamp(),
        };

        await hallDocRef.set(hallPayload);

        publishedItemsCount = 1;
        print('✅ تم نشر قاعة الأعراس في مجموعة hall بمعرف: ${hallDocRef.id}');

        // نشر في published_items أيضاً (للتوافق مع شاشة العناصر)
        try {
          final publishedItemRef = FirebaseFirestore.instance
              .collection('published_items')
              .doc(hallDocRef.id);
          await publishedItemRef.set(hallPayload);
          print(
            '✅ تم نشر القاعة أيضاً في published_items بمعرف: ${publishedItemRef.id}',
          );
        } catch (e) {
          print('⚠️ تعذر نشر القاعة في published_items: $e');
        }

        // التحقق من حفظ البيانات في hall
        final savedHallDoc = await hallDocRef.get();
        if (savedHallDoc.exists) {
          print('✅ تم التحقق: القاعة موجودة في مجموعة hall');
          final savedData = savedHallDoc.data();
          print('   - اسم القاعة: ${savedData?['hallName']}');
          print('   - providerId: ${savedData?['providerId']}');
          print('   - السعة: ${savedData?['capacity']}');
        } else {
          print('❌ خطأ: القاعة غير موجودة في مجموعة hall بعد الحفظ!');
        }

        // نشر أيضاً في مجموعة عربية مطابقة (قاعات اعراس)
        try {
          final hallArabicRef = FirebaseFirestore.instance
              .collection(arabicCollection)
              .doc(hallDocRef.id);
          await hallArabicRef.set(hallPayload);
          print(
            '✅ تم نشر القاعة أيضاً في مجموعة "$arabicCollection" بمعرف: ${hallArabicRef.id}',
          );
        } catch (e) {
          print('⚠️ تعذر النشر في مجموعة "$arabicCollection": $e');
        }
      } else {
        // نشر العناصر العادية في المجموعة المناسبة (restaurant, cake, car, etc.)
        print('📦 نشر العناصر في مجموعة $category...');

        // دمج العناصر القديمة مع الجديدة
        List<dynamic> allItems = [];

        // إضافة العناصر الجديدة
        allItems.addAll(items);

        // لا نضيف العناصر القديمة هنا لأنها منشورة مسبقاً
        // فقط ننشر العناصر الجديدة
        print('📦 عدد العناصر الجديدة للنشر: ${items.length}');

        for (var item in items) {
          final itemDocRef = FirebaseFirestore.instance
              .collection(category)
              .doc();

          final itemPayload = {
            'id': itemDocRef.id,
            'providerId': providerId,
            'providerName': finalProviderName,
            'providerPhone': finalPhone,
            'category': category,
            'categoryArabic': arabicCollection,
            'serviceName': finalServiceName,
            'serviceType': finalServiceName,
            'location': requestData['location'] ?? '',
            'governorate': finalGovernorate,
            'area': finalArea,
            'phone': finalPhone,
            'name': item['name'] ?? '',
            'details': item['details'] ?? '',
            'price': _parsePrice(item['price']),
            'imageUrls': item['imageUrls'] ?? item['images'] ?? [],
            'imageUrl': _getFirstImage(
              item['imageUrls'] ?? item['images'] ?? [],
            ),
            'isActive': true,
            'status': 'approved',
            'bookedDates': <String>[],
            'totalBookings': 0,
            'rating': 0.0,
            'reviewCount': 0,
            'publishedAt': FieldValue.serverTimestamp(),
            'createdAt': FieldValue.serverTimestamp(),
            'approvedAt': FieldValue.serverTimestamp(),
          };

          await itemDocRef.set(itemPayload);

          publishedItemsCount++;
          print('✅ تم نشر عنصر: ${item['name']} في مجموعة $category');

          // نشر في published_items أيضاً (للتوافق مع شاشة العناصر)
          try {
            final publishedItemRef = FirebaseFirestore.instance
                .collection('published_items')
                .doc(itemDocRef.id);
            await publishedItemRef.set(itemPayload);
            print(
              '✅ تم نشر العنصر أيضاً في published_items بمعرف: ${publishedItemRef.id}',
            );
          } catch (e) {
            print('⚠️ تعذر نشر العنصر في published_items: $e');
          }

          // نشر أيضاً في المجموعة العربية المكافئة
          try {
            final itemArabicRef = FirebaseFirestore.instance
                .collection(arabicCollection)
                .doc(itemDocRef.id);
            await itemArabicRef.set(itemPayload);
            print(
              '✅ تم نشر العنصر أيضاً في "$arabicCollection" بمعرف: ${itemArabicRef.id}',
            );
          } catch (e) {
            print('⚠️ تعذر نشر العنصر في مجموعة "$arabicCollection": $e');
          }
        }
      }

      print('✅ تم نشر $publishedItemsCount عنصر');

      // تحديث حالة العناصر في المجموعات الأصلية (hall, restaurant, etc.)
      print('🔄 بدء تحديث حالة العناصر في المجموعات الأصلية...');
      await _updateOriginalItemsStatus(providerId, category, 'approved');

      // تحديث اسم المزود في البيانات الموجودة للتأكد من استخدام الاسم التجاري
      await _updateExistingProviderData(providerId, finalProviderName);

      // نسخ بيانات المزود إلى provider_services (للتوافق مع النظام القديم)
      await FirebaseFirestore.instance
          .collection('provider_services')
          .doc(providerId)
          .set({
            'serviceName': finalServiceName,
            'serviceType': requestData['serviceType'],
            'providerId': providerId,
            'providerName': finalProviderName,
            'providerPhone': finalPhone,
            'location': requestData['location'],
            'area': finalArea,
            'governorate': finalGovernorate,
            'createdAt': FieldValue.serverTimestamp(),
            'status': 'approved',
          });

      // طباعة ملخص نهائي
      print('');
      print('═══════════════════════════════════════════════');
      print('🎉 ملخص الموافقة والنشر:');
      print('═══════════════════════════════════════════════');
      print('✅ المزود: $finalProviderName (ID: $providerId)');
      print('✅ الفئة: $category (عربي: $arabicCollection)');
      print('✅ نوع: ${isHallProvider ? "قاعة أعراس" : "خدمة عادية"}');
      print('✅ تم النشر في published_providers: نعم');
      print('✅ تم النشر في published_items: نعم');
      if (isHallProvider) {
        print('✅ تم النشر في مجموعة hall: نعم');
        print('✅ تم النشر في مجموعة "$arabicCollection": نعم');
      } else {
        print('✅ عدد العناصر المنشورة في $category: $publishedItemsCount');
        print(
          '✅ عدد العناصر المنشورة في published_items: $publishedItemsCount',
        );
        print(
          '✅ عدد العناصر المنشورة في "$arabicCollection": $publishedItemsCount',
        );
      }
      print('═══════════════════════════════════════════════');
      print('');

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            isHallProvider
                ? '✅ تمت الموافقة ونشر قاعة الأعراس في 4 مجموعات بنجاح!'
                : '✅ تمت الموافقة ونشر المزود و $publishedItemsCount عنصر في 4 مجموعات بنجاح!',
          ),
          backgroundColor: const Color(0xFF10B981),
          duration: const Duration(seconds: 3),
        ),
      );

      _loadProviderRequests(); // إعادة تحميل البيانات
    } catch (e) {
      print('❌ خطأ في الموافقة: $e');
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('حدث خطأ أثناء الموافقة: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  // دالة لتحديث حالة العناصر في المجموعات الأصلية
  Future<void> _updateOriginalItemsStatus(
    String providerId,
    String category,
    String newStatus,
  ) async {
    try {
      print(
        '🔄 تحديث عناصر المزود $providerId في مجموعة $category إلى حالة $newStatus',
      );

      // تحديد أسماء المجموعات التي قد تحتوي على العناصر
      List<String> possibleCollections = [
        'hall',
        'restaurant',
        'hotel',
        'cake',
        'flowers',
        'photography',
        'salon_care',
        'honeymoon',
        'bride_dress',
        'groom_suit',
        'car',
        'car_decoration',
        'other',
      ];

      int updatedItemsCount = 0;

      // البحث في جميع المجموعات المحتملة وتحديث العناصر
      for (String collectionName in possibleCollections) {
        final itemsQuery = await FirebaseFirestore.instance
            .collection(collectionName)
            .where('providerId', isEqualTo: providerId)
            .get();

        if (itemsQuery.docs.isNotEmpty) {
          print(
            '📦 وجد ${itemsQuery.docs.length} عنصر في مجموعة $collectionName للمزود $providerId',
          );

          final batch = FirebaseFirestore.instance.batch();
          for (var doc in itemsQuery.docs) {
            batch.update(doc.reference, {
              'status': newStatus,
              'approvedAt': newStatus == 'approved'
                  ? FieldValue.serverTimestamp()
                  : null,
              'rejectedAt': newStatus == 'rejected'
                  ? FieldValue.serverTimestamp()
                  : null,
              'adminComments': newStatus == 'approved'
                  ? 'تمت الموافقة على العنصر من قبل الإدارة'
                  : (newStatus == 'rejected'
                        ? 'تم رفض العنصر من قبل الإدارة'
                        : ''),
            });
            updatedItemsCount++;
          }

          await batch.commit();
          print(
            '✅ تم تحديث ${itemsQuery.docs.length} عنصر في مجموعة $collectionName',
          );
        }
      }

      print('🎉 إجمالي العناصر المحدثة: $updatedItemsCount');
    } catch (e) {
      print('❌ خطأ في تحديث حالة العناصر الأصلية: $e');
    }
  }

  // دالة لتحديث البيانات الموجودة للمزودين لضمان استخدام الاسم التجاري
  Future<void> _updateExistingProviderData(
    String providerId,
    String correctProviderName,
  ) async {
    try {
      // تحديث اسم المزود في published_providers
      await FirebaseFirestore.instance
          .collection('published_providers')
          .doc(providerId)
          .update({'providerName': correctProviderName});

      // تحديث اسم المزود في جميع العناصر المنشورة
      final itemsQuery = await FirebaseFirestore.instance
          .collection('published_items')
          .where('providerId', isEqualTo: providerId)
          .get();

      final batch = FirebaseFirestore.instance.batch();
      for (var doc in itemsQuery.docs) {
        batch.update(doc.reference, {'providerName': correctProviderName});
      }

      if (itemsQuery.docs.isNotEmpty) {
        await batch.commit();
        print(
          '✅ تم تحديث ${itemsQuery.docs.length} عنصر بالاسم التجاري الصحيح',
        );
      }
    } catch (e) {
      print('⚠️ خطأ في تحديث البيانات الموجودة: $e');
    }
  }

  /// تحويل اسم الخدمة بالعربي إلى معرف مجموعة Firestore (slug)
  ///
  /// الأسماء المدعومة:
  /// - قاعات: 'قاعة عرس', 'قاعات اعراس', 'صالة', 'hall'
  /// - كيك: 'كيك', 'حلويات'
  /// - مطاعم: 'مطعم', 'مطاعم', 'طعام'
  /// - سيارات: 'تأجير سيارات', 'تاجير السيارات', 'سيارة', 'سيارات', 'car'
  /// - فساتين: 'فستان', 'فساتين', 'عروس', 'زفاف'
  /// - بدلات رجالي: 'بدلة', 'بدلات', 'رجالي', 'رجالية', 'عريس'
  /// - ورود: 'زهور', 'ورد', 'زهرة'
  /// - صالونات: 'تجميل', 'صالون', 'عناية', 'مكياج'
  /// - فنادق: 'فندق', 'فنادق', 'إقامة', 'نزل'
  /// - شهر عسل: 'شهر عسل', 'سياحة', 'honeymoon'
  /// - تزيين سيارات: 'تزيين' + 'سيار'
  String _getServiceCategory(String? serviceName) {
    if (serviceName == null || serviceName.isEmpty) {
      return 'other';
    }

    final serviceNameLower = serviceName.toLowerCase();

    // قاعات أعراس - أولوية عالية
    if (serviceNameLower.contains('قاعة') ||
        serviceNameLower.contains('قاعات') ||
        serviceNameLower.contains('صالة') ||
        serviceNameLower.contains('عرس') ||
        serviceNameLower.contains('اعراس') ||
        serviceNameLower.contains('hall')) {
      return 'hall';
    }
    // كيك وحلويات
    else if (serviceNameLower.contains('كيك') ||
        serviceNameLower.contains('حلويات')) {
      return 'cake';
    }
    // مطاعم
    else if (serviceNameLower.contains('مطعم') ||
        serviceNameLower.contains('مطاعم') ||
        serviceNameLower.contains('طعام')) {
      return 'restaurant';
    }
    // تأجير سيارات - تحسين الكشف
    else if (serviceNameLower.contains('تأجير') ||
        serviceNameLower.contains('سيارة') ||
        serviceNameLower.contains('سيارات') ||
        serviceNameLower.contains('نقل') ||
        serviceNameLower == 'car') {
      return 'car';
    }
    // فساتين زفاف
    else if (serviceNameLower.contains('فستان') ||
        serviceNameLower.contains('فساتين') ||
        serviceNameLower.contains('عروس') ||
        serviceNameLower.contains('زفاف')) {
      return 'bride_dress';
    }
    // بدلات رجالي - تحسين الكشف
    else if (serviceNameLower.contains('بدلة') ||
        serviceNameLower.contains('بدلات') ||
        serviceNameLower.contains('رجالي') ||
        serviceNameLower.contains('رجالية') ||
        serviceNameLower.contains('عريس')) {
      return 'groom_suit';
    }
    // ورود وزهور
    else if (serviceNameLower.contains('زهور') ||
        serviceNameLower.contains('ورد') ||
        serviceNameLower.contains('زهرة')) {
      return 'flowers';
    }
    // صالونات تجميل
    else if (serviceNameLower.contains('تجميل') ||
        serviceNameLower.contains('صالون') ||
        serviceNameLower.contains('عناية') ||
        serviceNameLower.contains('مكياج')) {
      return 'salon_care';
    }
    // فنادق
    else if (serviceNameLower.contains('فندق') ||
        serviceNameLower.contains('فنادق') ||
        serviceNameLower.contains('إقامة') ||
        serviceNameLower.contains('نزل')) {
      return 'hotel';
    }
    // شهر عسل
    else if (serviceNameLower.contains('شهر عسل') ||
        serviceNameLower.contains('سياحة') ||
        serviceNameLower.contains('honeymoon')) {
      return 'honeymoon';
    }
    // تزيين سيارات
    else if (serviceNameLower.contains('تزيين') &&
        serviceNameLower.contains('سيار')) {
      return 'car_decoration';
    } else {
      return 'other';
    }
  }

  String _getFirstImage(dynamic images) {
    if (images == null) return '';
    if (images is List && images.isNotEmpty) {
      return images[0].toString();
    }
    return images.toString();
  }

  // خريطة اسم الخدمة إلى اسم المجموعة بالعربي
  String _getArabicCollection(String? serviceName) {
    if (serviceName == null || serviceName.isEmpty) return 'خدمات عامة';
    final s = serviceName.toLowerCase();

    // قاعات أعراس
    if (s.contains('قاعة') ||
        s.contains('قاعات') ||
        s.contains('صالة') ||
        s.contains('عرس') ||
        s.contains('اعراس') ||
        s.contains('hall')) {
      return 'قاعات اعراس';
    }
    // كيك وحلويات
    if (s.contains('كيك') || s.contains('حلويات')) return 'كيك';
    // مطاعم
    if (s.contains('مطعم') || s.contains('مطاعم') || s.contains('طعام'))
      return 'مطاعم';
    // تأجير سيارات - محسّن
    if (s.contains('تأجير') ||
        s.contains('سيارة') ||
        s.contains('سيارات') ||
        s.contains('نقل') ||
        s == 'car') {
      return 'تأجير سيارات';
    }
    // فساتين زفاف
    if (s.contains('فستان') ||
        s.contains('فساتين') ||
        s.contains('عروس') ||
        s.contains('زفاف')) {
      return 'فساتين زفاف';
    }
    // بدلات رجالية - محسّن
    if (s.contains('بدلة') ||
        s.contains('بدلات') ||
        s.contains('رجالي') ||
        s.contains('رجالية') ||
        s.contains('عريس')) {
      return 'بدلات رجالية';
    }
    // ورود وزهور
    if (s.contains('زهور') || s.contains('ورد') || s.contains('زهرة'))
      return 'ورود';
    // صالونات تجميل
    if (s.contains('تجميل') ||
        s.contains('صالون') ||
        s.contains('عناية') ||
        s.contains('مكياج')) {
      return 'صالونات تجميل';
    }
    // فنادق
    if (s.contains('فندق') ||
        s.contains('فنادق') ||
        s.contains('إقامة') ||
        s.contains('نزل')) {
      return 'فنادق';
    }
    // شهر عسل
    if (s.contains('شهر عسل') ||
        s.contains('سياحة') ||
        s.contains('honeymoon')) {
      return 'شهر عسل';
    }
    // تزيين سيارات
    if (s.contains('تزيين') && s.contains('سيار')) {
      return 'تزيين السيارات';
    }

    return 'خدمات عامة';
  }

  Future<void> _rejectNewRequest(Map<String, dynamic> requestData) async {
    final TextEditingController commentController = TextEditingController();

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('رفض الطلب'),
        content: TextField(
          controller: commentController,
          maxLines: 3,
          decoration: const InputDecoration(
            labelText: 'سبب الرفض',
            border: OutlineInputBorder(),
            hintText: 'أدخل سبب رفض هذا الطلب...',
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('cancel'.tr()),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: Colors.red),
            onPressed: () async {
              try {
                final requestId = requestData['requestId'];
                final providerId =
                    requestData['providerId'] ??
                    requestData['providerPhone'] ??
                    requestData['userPhone'];
                final serviceName =
                    requestData['serviceType'] ?? requestData['serviceName'];
                String category = _getServiceCategory(serviceName);

                await FirebaseFirestore.instance
                    .collection('provider_requests')
                    .doc(requestId)
                    .update({
                      'status': 'rejected',
                      'rejectedAt': FieldValue.serverTimestamp(),
                      'adminComments': commentController.text.trim(),
                    });

                // تحديث حالة العناصر في المجموعات الأصلية
                if (providerId != null) {
                  await _updateOriginalItemsStatus(
                    providerId,
                    category,
                    'rejected',
                  );
                }

                Navigator.pop(context);
                ScaffoldMessenger.of(
                  context,
                ).showSnackBar(const SnackBar(content: Text('تم رفض الطلب')));

                _loadProviderRequests(); // إعادة تحميل البيانات
              } catch (e) {
                ScaffoldMessenger.of(
                  context,
                ).showSnackBar(SnackBar(content: Text('خطأ: $e')));
              }
            },
            child: const Text('reject'.tr()),
          ),
        ],
      ),
    );
  }

  Widget _buildInfoRow(String label, String? value) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 8),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          SizedBox(
            width: 100,
            child: Text(
              '$label:',
              style: const TextStyle(
                fontSize: 14,
                fontWeight: FontWeight.bold,
                color: Colors.grey,
              ),
            ),
          ),
          Expanded(
            child: Text(
              value ?? 'غير محدد',
              style: const TextStyle(fontSize: 14, color: Color(0xFF2D3748)),
            ),
          ),
        ],
      ),
    );
  }

  Future<void> _contactProvider(Map<String, dynamic> requestData) async {
    final providerName =
        requestData['name'] ?? requestData['providerName'] ?? 'مزود خدمة';
    final providerPhone =
        requestData['phone'] ?? requestData['providerPhone'] ?? '';
    final providerId = requestData['providerId'] ?? providerPhone;

    if (providerId.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('معلومات المزود غير متوفرة')),
      );
      return;
    }

    // فتح محادثة مباشرة مع المزود
    ChatHelper.startChatWithUser(
      context: context,
      otherUserId: providerId,
      otherUserName: providerName,
      otherUserRole: 'provider',
    );
  }

  // وظيفة لتحديث جميع العناصر المعتمدة سابقاً لحل مشكلة العناصر المعلقة
  Future<void> _updateAllApprovedItemsStatus() async {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (context) => const AlertDialog(
        content: Row(
          children: [
            CircularProgressIndicator(),
            SizedBox(width: 16),
            Text('جاري تحديث العناصر المعتمدة...'),
          ],
        ),
      ),
    );

    try {
      print('🔄 بدء تحديث جميع العناصر المعتمدة سابقاً...');

      // الحصول على جميع الطلبات المعتمدة
      final approvedRequestsSnapshot = await FirebaseFirestore.instance
          .collection('provider_requests')
          .where('status', isEqualTo: 'approved')
          .get();

      print('📊 عدد الطلبات المعتمدة: ${approvedRequestsSnapshot.docs.length}');

      int totalUpdatedItems = 0;

      // تحديث العناصر لكل طلب معتمد
      for (var requestDoc in approvedRequestsSnapshot.docs) {
        final requestData = requestDoc.data();
        final providerId =
            requestData['providerId'] ??
            requestData['providerPhone'] ??
            requestData['userPhone'];
        final serviceName =
            requestData['serviceType'] ?? requestData['serviceName'];

        if (providerId != null) {
          String category = _getServiceCategory(serviceName);
          print('🔄 تحديث عناصر المزود $providerId في فئة $category');

          // تحديث العناصر في المجموعات الأصلية
          int updatedCount = await _updateOriginalItemsStatusWithCount(
            providerId,
            category,
            'approved',
          );
          totalUpdatedItems += updatedCount;
        }
      }

      Navigator.pop(context); // إغلاق dialog التحميل

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('✅ تم تحديث $totalUpdatedItems عنصر بنجاح!'),
          backgroundColor: const Color(0xFF10B981),
          duration: const Duration(seconds: 3),
        ),
      );

      print(
        '🎉 انتهى تحديث العناصر المعتمدة - المجموع: $totalUpdatedItems عنصر',
      );
    } catch (e) {
      Navigator.pop(context); // إغلاق dialog التحميل
      print('❌ خطأ في تحديث العناصر المعتمدة: $e');
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('حدث خطأ أثناء التحديث: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  // نسخة معدلة من _updateOriginalItemsStatus تعيد عدد العناصر المحدثة
  Future<int> _updateOriginalItemsStatusWithCount(
    String providerId,
    String category,
    String newStatus,
  ) async {
    int updatedItemsCount = 0;

    try {
      print(
        '🔄 تحديث عناصر المزود $providerId في مجموعة $category إلى حالة $newStatus',
      );

      // تحديد أسماء المجموعات التي قد تحتوي على العناصر
      List<String> possibleCollections = [
        'hall',
        'restaurant',
        'hotel',
        'cake',
        'flowers',
        'photography',
        'salon_care',
        'honeymoon',
        'bride_dress',
        'groom_suit',
        'car',
        'car_decoration',
        'other',
      ];

      // البحث في جميع المجموعات المحتملة وتحديث العناصر
      for (String collectionName in possibleCollections) {
        final itemsQuery = await FirebaseFirestore.instance
            .collection(collectionName)
            .where('providerId', isEqualTo: providerId)
            .get();

        if (itemsQuery.docs.isNotEmpty) {
          print(
            '📦 وجد ${itemsQuery.docs.length} عنصر في مجموعة $collectionName للمزود $providerId',
          );

          final batch = FirebaseFirestore.instance.batch();
          for (var doc in itemsQuery.docs) {
            batch.update(doc.reference, {
              'status': newStatus,
              'approvedAt': newStatus == 'approved'
                  ? FieldValue.serverTimestamp()
                  : null,
              'rejectedAt': newStatus == 'rejected'
                  ? FieldValue.serverTimestamp()
                  : null,
              'adminComments': newStatus == 'approved'
                  ? 'تمت الموافقة على العنصر من قبل الإدارة'
                  : (newStatus == 'rejected'
                        ? 'تم رفض العنصر من قبل الإدارة'
                        : ''),
            });
            updatedItemsCount++;
          }

          await batch.commit();
          print(
            '✅ تم تحديث ${itemsQuery.docs.length} عنصر في مجموعة $collectionName',
          );
        }
      }

      print('🎉 إجمالي العناصر المحدثة للمزود $providerId: $updatedItemsCount');
    } catch (e) {
      print('❌ خطأ في تحديث حالة العناصر الأصلية: $e');
    }

    return updatedItemsCount;
  }

