// شاشة إضافة عناصر الخدمة لمزود الخدمة
class ProviderServiceItemsScreen extends StatefulWidget {
  const ProviderServiceItemsScreen({super.key});

  @override
  State<ProviderServiceItemsScreen> createState() =>
      _ProviderServiceItemsScreenState();
}

class _ProviderServiceItemsScreenState
    extends State<ProviderServiceItemsScreen> {
  bool hasSubmittedInitialServices = false;
  List<Map<String, dynamic>> services = [];
  Map<String, List<Map<String, dynamic>>> serviceItems = {};
  Map<String, List<Map<String, dynamic>>> pendingItems = {};
  Map<String, dynamic>? providerInfo;
  String? currentUserId;
  bool isLoading = true;

  @override
  void initState() {
    super.initState();
    _loadUserData();
  }

  Future<void> _loadUserData() async {
    final prefs = await SharedPreferences.getInstance();
    currentUserId = prefs.getString('user_phone');
    if (currentUserId != null) {
      await _checkInitialSubmission();
      if (hasSubmittedInitialServices) {
        await _loadUserServices();
        await _loadProviderInfo();
        await _loadAllItems();
      }
    }
    setState(() {
      isLoading = false;
    });
  }

  Future<void> _loadProviderInfo() async {
    if (currentUserId == null) return;
    final userDoc = await FirebaseFirestore.instance
        .collection('users')
        .doc(currentUserId)
        .get();
    if (userDoc.exists) {
      providerInfo = userDoc.data();
    }
  }

  Future<void> _loadAllItems() async {
    serviceItems.clear();
    pendingItems.clear();
    for (var service in services) {
      final serviceId = service['id'];
      // العناصر المعتمدة
      final itemsSnap = await FirebaseFirestore.instance
          .collection('service_items')
          .where('serviceId', isEqualTo: serviceId)
          .get();
      serviceItems[serviceId] = itemsSnap.docs.map((doc) {
        final data = doc.data();
        data['id'] = doc.id;
        return data;
      }).toList();
      // العناصر المعلقة
      final pendingSnap = await FirebaseFirestore.instance
          .collection('pending_service_items')
          .where('serviceId', isEqualTo: serviceId)
          .get();
      pendingItems[serviceId] = pendingSnap.docs.map((doc) {
        final data = doc.data();
        data['id'] = doc.id;
        return data;
      }).toList();
    }
    setState(() {});
  }

  Future<void> _checkInitialSubmission() async {
    if (currentUserId == null) return;
    final userDoc = await FirebaseFirestore.instance
        .collection('users')
        .doc(currentUserId)
        .get();
    if (userDoc.exists) {
      final userData = userDoc.data() as Map<String, dynamic>;
      hasSubmittedInitialServices =
          userData['hasSubmittedInitialServices'] ?? false;
    }
  }

  // جلب الخدمات المعتمدة فقط من approved_services
  Future<void> _loadUserServices() async {
    if (currentUserId == null) return;
    final servicesSnapshot = await FirebaseFirestore.instance
        .collection('approved_services')
        .where('providerId', isEqualTo: currentUserId)
        .get();
    setState(() {
      services = servicesSnapshot.docs.map((doc) {
        final data = doc.data();
        data['id'] = doc.id;
        return data;
      }).toList();
    });
  }

  @override
  Widget build(BuildContext context) {
    if (isLoading) {
      return Scaffold(
        appBar: AppBar(title: Text('خدماتي')),
        body: Center(child: CircularProgressIndicator()),
      );
    }

    if (!hasSubmittedInitialServices) {
      return _buildInitialServiceForm();
    } else {
      return _buildServicesManagement();
    }
  }

  Widget _buildInitialServiceForm() {
    return ServiceFormScreen(
      isInitial: true,
      onSubmit: (serviceData) async {
        await _submitInitialService(serviceData);
      },
    );
  }

  Future<void> _submitInitialService(Map<String, dynamic> serviceData) async {
    if (currentUserId == null) return;
    try {
      final serviceRef = FirebaseFirestore.instance
          .collection('pending_services')
          .doc();
      serviceData['id'] = serviceRef.id;
      serviceData['providerId'] = currentUserId;
      serviceData['createdAt'] = FieldValue.serverTimestamp();
      serviceData['bookedDates'] = <String>[];
      serviceData['status'] = 'pending';
      if (!serviceData.containsKey('category') ||
          serviceData['category'] == null ||
          serviceData['category'].toString().isEmpty) {
        serviceData['category'] = 'other';
      }
      await serviceRef.set(serviceData);
      await FirebaseFirestore.instance
          .collection('users')
          .doc(currentUserId)
          .update({'hasSubmittedInitialServices': true});
      await FirebaseFirestore.instance.collection('provider_requests').add({
        'providerId': currentUserId,
        'services': [serviceData],
        'status': 'pending',
        'createdAt': FieldValue.serverTimestamp(),
        'type': 'initial_submission',
      });
      setState(() {
        hasSubmittedInitialServices = true;
        services = [serviceData];
      });
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('تم إرسال الخدمة للموافقة بنجاح!'),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('حدث خطأ: $e')));
    }
  }
}

// صفحة الحساب لمزود الخدمة (محدثة)
class ProviderAccountScreen extends StatefulWidget {
  const ProviderAccountScreen({super.key});

  @override
  State<ProviderAccountScreen> createState() => _ProviderAccountScreenState();
}

class _ProviderAccountScreenState extends State<ProviderAccountScreen> {
  bool _showPersonalInfo = false;

  @override
  Widget build(BuildContext context) {
    return FutureBuilder<SharedPreferences>(
      future: SharedPreferences.getInstance(),
      builder: (context, prefsSnapshot) {
        if (!prefsSnapshot.hasData) {
          return Scaffold(body: Center(child: CircularProgressIndicator()));
        }
        final prefs = prefsSnapshot.data!;
        final currentUserId = prefs.getString('user_phone') ?? '';
        return StreamBuilder<DocumentSnapshot>(
          stream: FirebaseFirestore.instance
              .collection('users')
              .doc(currentUserId)
              .snapshots(),
          builder: (context, userSnapshot) {
            if (!userSnapshot.hasData) {
              return Scaffold(body: Center(child: CircularProgressIndicator()));
            }
            final userData = userSnapshot.data!.data() as Map<String, dynamic>?;
            final displayName = userData?['displayName'] ?? 'اسم مزود الخدمة';
            final serviceName =
                userData?['serviceName'] ??
                userData?['serviceType'] ??
                'الخدمة';
            final phone = userData?['phone'] ?? currentUserId;
            final profileImage = userData?['profileImage'] as String?;
            final governorate = userData?['governorate'] ?? 'غير محدد';
            final area = userData?['area'] ?? 'غير محدد';
            final creditCard = userData?['creditCard'] ?? 'غير محدد';

            return Scaffold(
              backgroundColor: Colors.grey[100],
              body: CustomScrollView(
                slivers: [
                  // AppBar مع اسم الخدمة واللون المطلوب
                  SliverAppBar(
                    expandedHeight: 180,
                    pinned: true,
                    backgroundColor: Theme.of(
                      context,
                    ).appBarTheme.backgroundColor,
                    flexibleSpace: FlexibleSpaceBar(
                      centerTitle: true,
                      title: Column(
                        mainAxisAlignment: MainAxisAlignment.end,
                        children: [
                          Text(
                            serviceName,
                            style: const TextStyle(
                              color: Colors.white,
                              fontSize: 22,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                          const SizedBox(height: 4),
                          Text(
                            displayName,
                            style: const TextStyle(
                              color: Colors.white70,
                              fontSize: 14,
                            ),
                          ),
                        ],
                      ),
                      background: Container(
                        color: Theme.of(context).appBarTheme.backgroundColor,
                        child: Center(
                          child: profileImage != null
                              ? CircleAvatar(
                                  radius: 50,
                                  backgroundImage: NetworkImage(profileImage),
                                  backgroundColor: Colors.white,
                                )
                              : const CircleAvatar(
                                  radius: 50,
                                  backgroundColor: Colors.white,
                                  child: Icon(
                                    Icons.person,
                                    size: 50,
                                    color: Color(0xFF2B0606),
                                  ),
                                ),
                        ),
                      ),
                    ),
                  ),

                  // المحتوى
                  SliverToBoxAdapter(
                    child: Padding(
                      padding: const EdgeInsets.all(16),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          // معلومات الحساب - قابلة للضغط
                          Card(
                            elevation: 3,
                            shape: RoundedRectangleBorder(
                              borderRadius: BorderRadius.circular(12),
                            ),
                            child: InkWell(
                              onTap: () {
                                setState(() {
                                  _showPersonalInfo = !_showPersonalInfo;
                                });
                              },
                              borderRadius: BorderRadius.circular(12),
                              child: Padding(
                                padding: const EdgeInsets.all(16),
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Row(
                                      mainAxisAlignment:
                                          MainAxisAlignment.spaceBetween,
                                      children: [
                                        const Text(
                                          'معلومات الحساب',
                                          style: TextStyle(
                                            fontSize: 18,
                                            fontWeight: FontWeight.bold,
                                            color: Color(0xFF2B0606),
                                          ),
                                        ),
                                        Icon(
                                          _showPersonalInfo
                                              ? Icons.keyboard_arrow_up
                                              : Icons.keyboard_arrow_down,
                                          color: const Color(0xFF2B0606),
                                        ),
                                      ],
                                    ),
                                    if (_showPersonalInfo) ...[
                                      const Divider(height: 24),
                                      _buildInfoRow(
                                        Icons.person,
                                        'الاسم',
                                        displayName,
                                      ),
                                      const SizedBox(height: 12),
                                      _buildInfoRow(
                                        Icons.phone,
                                        'رقم الهاتف',
                                        phone,
                                      ),
                                      const SizedBox(height: 12),
                                      _buildInfoRow(
                                        Icons.location_city,
                                        'المحافظة',
                                        governorate,
                                      ),
                                      const SizedBox(height: 12),
                                      _buildInfoRow(
                                        Icons.location_on,
                                        'المنطقة',
                                        area,
                                      ),
                                      const SizedBox(height: 12),
                                      _buildInfoRow(
                                        Icons.credit_card,
                                        'بطاقة الائتمان',
                                        creditCard,
                                      ),
                                    ],
                                  ],
                                ),
                              ),
                            ),
                          ),

                          const SizedBox(height: 16),

                          // كشف الحساب (بدون حقول الإيرادات)
                          Row(
                            children: [
                              Icon(
                                Icons.receipt_long,
                                color: const Color(0xFF530405),
                              ),
                              const SizedBox(width: 8),
                              const Text(
                                'كشف الحساب',
                                style: TextStyle(
                                  fontSize: 18,
                                  fontWeight: FontWeight.bold,
                                ),
                              ),
                            ],
                          ),
                          const SizedBox(height: 12),
                          AccountStatementSection(providerId: currentUserId),
                          const SizedBox(height: 24),
                          // زر تسجيل الخروج
                          Center(
                            child: ElevatedButton.icon(
                              icon: const Icon(Icons.logout),
                              label: const Text('logout'.tr()),
                              style: ElevatedButton.styleFrom(
                                backgroundColor: const Color(0xFF530405),
                                foregroundColor: Colors.white,
                                padding: const EdgeInsets.symmetric(
                                  horizontal: 32,
                                  vertical: 16,
                                ),
                                shape: RoundedRectangleBorder(
                                  borderRadius: BorderRadius.circular(12),
                                ),
                              ),
                              onPressed: () async {
                                // مربع حوار للتأكيد
                                bool? shouldLogout = await showDialog<bool>(
                                  context: context,
                                  builder: (BuildContext context) {
                                    return AlertDialog(
                                      title: const Text('تأكيد تسجيل الخروج'),
                                      content: const Text(
                                        'هل أنت متأكد من أنك تريد تسجيل الخروج؟',
                                      ),
                                      actions: [
                                        TextButton(
                                          onPressed: () =>
                                              Navigator.of(context).pop(false),
                                          child: const Text('cancel'.tr()),
                                        ),
                                        TextButton(
                                          onPressed: () =>
                                              Navigator.of(context).pop(true),
                                          child: const Text('logout'.tr()),
                                        ),
                                      ],
                                    );
                                  },
                                );

                                if (shouldLogout == true) {
                                  // إظهار مؤشر التحميل
                                  showDialog(
                                    context: context,
                                    barrierDismissible: false,
                                    builder: (context) => const Center(
                                      child: CircularProgressIndicator(),
                                    ),
                                  );

                                  try {
                                    final prefs =
                                        await SharedPreferences.getInstance();
                                    final phone = prefs.getString('user_phone');

                                    if (phone != null && phone.isNotEmpty) {
                                      try {
                                        // تحديث حالة الجلسة في Firestore بأمان
                                        final sessionDoc = FirebaseFirestore
                                            .instance
                                            .collection('sessions')
                                            .doc(phone);

                                        final docSnapshot = await sessionDoc
                                            .get();
                                        if (docSnapshot.exists) {
                                          await sessionDoc.update({
                                            'active': false,
                                          });
                                        }
                                      } catch (e) {
                                        // تجاهل أخطاء Firestore وتابع عملية تسجيل الخروج
                                        print('خطأ في تحديث حالة الجلسة: $e');
                                      }
                                    }

                                    // حذف جميع البيانات المحلية
                                    await prefs.clear();

                                    // إعادة تعيين المتغيرات العامة العامة فقط
                                    hasSubmittedInitialServices = false;
                                    services.clear();
                                    serviceItems.clear();
                                    pendingItems.clear();

                                    // إغلاق مؤشر التحميل والانتقال لشاشة البداية
                                    Navigator.of(
                                      context,
                                    ).pop(); // إغلاق مؤشر التحميل
                                    Navigator.pushAndRemoveUntil(
                                      context,
                                      MaterialPageRoute(
                                        builder: (_) => SplashScreen(),
                                      ),
                                      (route) => false,
                                    );
                                  } catch (e) {
                                    // إغلاق مؤشر التحميل في حال وجود خطأ
                                    Navigator.of(context).pop();

                                    // حتى لو فشل تحديث Firestore، قم بتسجيل الخروج محلياً
                                    try {
                                      final prefs =
                                          await SharedPreferences.getInstance();
                                      await prefs.clear();

                                      hasSubmittedInitialServices = false;
                                      services.clear();
                                      serviceItems.clear();
                                      pendingItems.clear();

                                      Navigator.pushAndRemoveUntil(
                                        context,
                                        MaterialPageRoute(
                                          builder: (_) => SplashScreen(),
                                        ),
                                        (route) => false,
                                      );
                                    } catch (localError) {
                                      ScaffoldMessenger.of(
                                        context,
                                      ).showSnackBar(
                                        SnackBar(
                                          content: Text(
                                            'حدث خطأ أثناء تسجيل الخروج: $localError',
                                          ),
                                          backgroundColor: Colors.red,
                                        ),
                                      );
                                    }
                                  }
                                }
                              },
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ],
              ),
            );
          },
        );
      },
    );
  }

  Widget _buildInfoRow(IconData icon, String label, String value) {
    return Row(
      children: [
        Container(
          padding: const EdgeInsets.all(8),
          decoration: BoxDecoration(
            color: const Color(0xFF2B0606).withOpacity(0.1),
            borderRadius: BorderRadius.circular(8),
          ),
          child: Icon(icon, color: const Color(0xFF2B0606), size: 20),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                label,
                style: TextStyle(
                  fontSize: 12,
                  color: Colors.grey[600],
                  fontWeight: FontWeight.w500,
                ),
              ),
              Text(
                value,
                style: const TextStyle(
                  fontSize: 15,
                  color: Color(0xFF2D3748),
                  fontWeight: FontWeight.w600,
                ),
              ),
            ],
          ),
        ),
      ],
    );
  }
}

