    const String ownerPhone = '07721874360';

    if (_isLoading) {
      return const Scaffold(body: Center(child: CircularProgressIndicator()));
    }

    final name = _userData?['name'] ?? 'مستخدم';
    final phone = _userData?['phone'] ?? _userId ?? '';
    final governorate =
        _userData?['governorate'] ?? _userData?['city'] ?? 'غير محدد';
    final area = _userData?['area'] ?? 'غير محدد';
    final profileImage = _userData?['profileImage'];

    return Scaffold(
      backgroundColor: const Color(0xFFF5F5F5),
      appBar: AppBar(
        title: const Text(
          'الملف الشخصي',
          style: TextStyle(fontWeight: FontWeight.bold, color: Colors.white),
