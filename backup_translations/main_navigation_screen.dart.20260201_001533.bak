class MainNavigationScreen extends StatefulWidget {
  final bool isAdmin;
  const MainNavigationScreen({super.key, this.isAdmin = false});

  @override
  State<MainNavigationScreen> createState() => _MainNavigationScreenState();
}

class _MainNavigationScreenState extends State<MainNavigationScreen> {
  int _selectedIndex = 0;

  String? _currentUserId;
  String _providerName = 'مزود الخدمة';

  @override
  void initState() {
    super.initState();
    _loadCurrentUserId();
  }

  Future<void> _loadCurrentUserId() async {
    final prefs = await SharedPreferences.getInstance();
    final phone = prefs.getString('user_phone');
    final name = prefs.getString('user_name') ?? 'مزود الخدمة';
    setState(() {
      _currentUserId = phone ?? '';
      _providerName = name;
    });
    print(
      'Loaded currentUserId: $_currentUserId, providerName: $_providerName',
    );
  }

  List<Widget> get _pages {
    if (widget.isAdmin) {
      // صفحات مزود الخدمة
      return [
        ProviderDashboardNew(
          providerId: _currentUserId ?? '',
          providerName: _providerName,
        ), // الصفحة الرئيسية لمزود الخدمة
        ProviderBookingsScreen(), // الحجوزات
        ProviderAccountScreen(), // الحساب
        ProviderSupportScreen(), // الدعم الفني
      ];
    } else {
      // صفحات العميل العادي
      return [
        ServicesScreen(), // الرئيسية
        MyBookingsScreen(), // حجوزاتي
        const ChatsListScreen(), // المحادثات
        FazaaScreen(), // فزعة
        ProfileScreen(), // الملف الشخصي
      ];
    }
  }

  @override
  Widget build(BuildContext context) {
    if (_currentUserId == null) {
      // إظهار شاشة تسجيل الدخول مع زر للانتقال إلى شاشة إنشاء حساب
      return Scaffold(
        body: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const Text(
                'يرجى تسجيل الدخول أولاً',
                style: TextStyle(fontSize: 20),
              ),
              const SizedBox(height: 24),
              ElevatedButton(
                onPressed: () {
                  Navigator.of(context).pushReplacement(
                    MaterialPageRoute(builder: (_) => const LoginScreen()),
                  );
                },
                child: const Text('login'.tr()),
              ),
            ],
          ),
        ),
      );
    }

    return AnnotatedRegion<SystemUiOverlayStyle>(
      value: const SystemUiOverlayStyle(
        statusBarColor: Colors.transparent,
        statusBarIconBrightness: Brightness.dark,
        statusBarBrightness: Brightness.light,
      ),
      child: Scaffold(
        extendBodyBehindAppBar: true,
        backgroundColor: const Color.fromARGB(255, 216, 208, 208),
        body: IndexedStack(index: _selectedIndex, children: _pages),
        bottomNavigationBar: Directionality(
          textDirection: ui.TextDirection.ltr,
          child: BottomNavigationBar(
            type: BottomNavigationBarType.fixed,
            currentIndex: _selectedIndex,
            onTap: (index) => setState(() => _selectedIndex = index),
            selectedItemColor: const Color(0xFFB46A6A),
            unselectedItemColor: Colors.grey,
            elevation: 8,
            backgroundColor: Colors.white,
            selectedLabelStyle: const TextStyle(fontWeight: FontWeight.bold),
            items: widget.isAdmin
                ? const [
                    BottomNavigationBarItem(
                      icon: Icon(Icons.dashboard),
                      label: 'لوحة التحكم',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.book_online),
                      label: 'الحجوزات',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.account_circle),
                      label: 'الحساب',
                    ),
                    BottomNavigationBarItem(
                      icon: Icon(Icons.support_agent),
                      label: 'الدعم الفني',
                    ),
                  ]
                : [
                    BottomNavigationBarItem(
                      icon: const Icon(Icons.home),
                      label: 'services'.tr(),
                    ),
                    BottomNavigationBarItem(
                      icon: const Icon(Icons.book),
                      label: 'bookings'.tr(),
                    ),
                    BottomNavigationBarItem(
                      icon: const Icon(Icons.chat),
                      label: tr('chats'),
                    ),
                    BottomNavigationBarItem(
                      icon: const Icon(Icons.people_alt),
                      label: tr('fazaa'),
                    ),
                    BottomNavigationBarItem(
                      icon: const Icon(Icons.person),
                      label: 'profile'.tr(),
                    ),
                  ],
          ),
        ),
      ),
    );
  }
}

// شاشة الحساب (فارغة مؤقتاً)
class ProfileScreen extends StatefulWidget {
  const ProfileScreen({super.key});

  @override
  State<ProfileScreen> createState() => _ProfileScreenState();
}

class _ProfileScreenState extends State<ProfileScreen> {
  String? _userId;
  Map<String, dynamic>? _userData;
  int _bookingsCount = 0;
  bool _isLoading = true;
  bool _notificationsEnabled = true;
  final ImagePicker _picker = ImagePicker();

  @override
  void initState() {
    super.initState();
    _loadUserData();
  }

  Future<void> _loadUserData() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final userId = prefs.getString('user_phone');

      print('🔍 محاولة تحميل بيانات المستخدم لرقم: $userId');

      if (userId == null) {
        print('❌ لا يوجد user_phone في SharedPreferences');
        setState(() => _isLoading = false);
        return;
      }

      setState(() => _userId = userId);

      // تحميل بيانات المستخدم
      print('📥 جلب بيانات المستخدم من Firestore...');
      final userDoc = await FirebaseFirestore.instance
          .collection('users')
          .doc(userId)
          .get();

      Map<String, dynamic>? userData;

      if (userDoc.exists) {
        userData = userDoc.data();
        print('✅ تم العثور على بيانات المستخدم:');
        print('   📄 البيانات الكاملة: $userData');
      } else {
        print('⚠️ لم يتم العثور على مستند بالمعرف: $userId');
        print('🔄 محاولة البحث برقم الهاتف في حقل phone...');

        // محاولة البحث برقم الهاتف في حقل phone
        final querySnapshot = await FirebaseFirestore.instance
            .collection('users')
            .where('phone', isEqualTo: userId)
            .limit(1)
            .get();

        if (querySnapshot.docs.isNotEmpty) {
          userData = querySnapshot.docs.first.data();
          print('✅ تم العثور على المستخدم عبر البحث:');
          print('   📄 البيانات الكاملة: $userData');
        } else {
          print('❌ لم يتم العثور على المستخدم نهائياً!');
        }
      }

      // إثراء البيانات بجلب المحافظة والمنطقة من مصادر متعددة
      if (userData != null) {
        print('🔍 محاولة إثراء بيانات المستخدم...');
        print(
          '   📍 قبل: governorate="${userData['governorate']}", city="${userData['city']}", area="${userData['area']}"',
        );

        String? finalGov = userData['governorate'] ?? userData['city'];
        String? finalArea = userData['area'];

        // 1. محاولة جلب من users (قد يكون هناك تحديث)
        if ((finalGov == null || finalGov.isEmpty) ||
            (finalArea == null || finalArea.isEmpty)) {
          try {
            final userDocRefresh = await FirebaseFirestore.instance
                .collection('users')
                .doc(userId)
                .get();

            if (userDocRefresh.exists) {
              final refreshData = userDocRefresh.data();
              finalGov =
                  finalGov ??
                  refreshData?['governorate'] ??
                  refreshData?['city'];
              finalArea = finalArea ?? refreshData?['area'];
              print(
                '   📱 users (refresh): gov="$finalGov", area="$finalArea"',
              );
            }
          } catch (e) {
            print('   ❌ users refresh: خطأ - $e');
          }
        }

        // 2. محاولة جلب من providers إذا كان مزود خدمة
        if ((finalGov == null || finalGov.isEmpty) ||
            (finalArea == null || finalArea.isEmpty)) {
          try {
            final providerDoc = await FirebaseFirestore.instance
                .collection('providers')
                .doc(userId)
                .get();

            if (providerDoc.exists) {
              final providerData = providerDoc.data();
              finalGov = finalGov ?? providerData?['governorate'];
              finalArea = finalArea ?? providerData?['area'];
              print('   🏢 providers: gov="$finalGov", area="$finalArea"');
            }
          } catch (e) {
            print('   ❌ providers: خطأ - $e');
          }
        }

        // 3. محاولة جلب من provider_services
        if ((finalGov == null || finalGov.isEmpty) ||
            (finalArea == null || finalArea.isEmpty)) {
          try {
            final serviceDoc = await FirebaseFirestore.instance
                .collection('provider_services')
                .doc(userId)
                .get();

            if (serviceDoc.exists) {
              final serviceData = serviceDoc.data();
              finalGov =
                  finalGov ??
                  serviceData?['governorate'] ??
                  serviceData?['providerGovernorate'];
              finalArea = finalArea ?? serviceData?['area'];
              print(
                '   🎯 provider_services: gov="$finalGov", area="$finalArea"',
              );
            }
          } catch (e) {
            print('   ❌ provider_services: خطأ - $e');
          }
        }

        // تطبيق القيم النهائية
        if (finalGov != null && finalGov.isNotEmpty) {
          userData['governorate'] = finalGov;
          userData['city'] = finalGov;
        }
        if (finalArea != null && finalArea.isNotEmpty) {
          userData['area'] = finalArea;
        }

        print(
          '   📍 بعد: governorate="${userData['governorate']}", area="${userData['area']}"',
        );
        print('✅ اكتمل إثراء البيانات');
      }

      setState(() => _userData = userData);

      print('   👤 الاسم: ${userData?['name']}');
      print('   📍 المحافظة (governorate): ${userData?['governorate']}');
      print('   📍 المحافظة (city): ${userData?['city']}');
      print('   📍 المنطقة: ${userData?['area']}');
      print('   📞 الهاتف: ${userData?['phone']}');

      // حساب عدد الحجوزات المقبولة
      print('📊 حساب عدد الحجوزات...');
      final bookingsQuery = await FirebaseFirestore.instance
          .collection('bookings')
          .where('customerId', isEqualTo: userId)
          .where('isCancelled', isEqualTo: false)
          .get();

      print('✅ عدد الحجوزات المقبولة: ${bookingsQuery.docs.length}');

      // تحميل حالة الإشعارات
      final notifEnabled = prefs.getBool('notifications_enabled') ?? true;

      setState(() {
        _bookingsCount = bookingsQuery.docs.length;
        _notificationsEnabled = notifEnabled;
        _isLoading = false;
      });

      print('✅ اكتمل تحميل بيانات الملف الشخصي');
    } catch (e) {
      print('❌ خطأ في تحميل البيانات: $e');
      print('❌ تفاصيل الخطأ: ${e.toString()}');
      setState(() => _isLoading = false);
    }
  }

  Future<void> _updateProfileImage() async {
    try {
      final XFile? image = await _picker.pickImage(
        source: ImageSource.gallery,
        maxWidth: 512,
        maxHeight: 512,
        imageQuality: 85,
      );

      if (image == null || _userId == null) return;

      // عرض مؤشر التحميل
      showDialog(
        context: context,
        barrierDismissible: false,
        builder: (context) => const Center(child: CircularProgressIndicator()),
      );

      // رفع الصورة إلى Firebase Storage
      final ref = FirebaseStorage.instance.ref().child(
        'profile_images/$_userId.jpg',
      );

      await ref.putData(await image.readAsBytes());
      final imageUrl = await ref.getDownloadURL();

      // تحديث قاعدة البيانات
      await FirebaseFirestore.instance.collection('users').doc(_userId).update({
        'profileImage': imageUrl,
      });

      Navigator.of(context).pop(); // إغلاق مؤشر التحميل

      setState(() {
        _userData!['profileImage'] = imageUrl;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('تم تحديث صورة الملف الشخصي بنجاح'),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      Navigator.of(context).pop(); // إغلاق مؤشر التحميل
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('خطأ في تحديث الصورة: $e')));
    }
  }

