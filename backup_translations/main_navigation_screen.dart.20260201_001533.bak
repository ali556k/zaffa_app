// دالة لنقل الخدمة من pending_services إلى approved_services عند الموافقة
Future<void> approveService(String serviceId) async {
  try {
    final pendingDoc = await FirebaseFirestore.instance
        .collection('pending_services')
        .doc(serviceId)
        .get();
    if (pendingDoc.exists) {
      final serviceData = pendingDoc.data();
      await FirebaseFirestore.instance
          .collection('approved_services')
          .doc(serviceId)
          .set(serviceData!);
      await FirebaseFirestore.instance
          .collection('pending_services')
          .doc(serviceId)
          .delete();
      // يمكنك هنا إضافة منطق إضافي مثل إشعار المزود أو تحديث واجهة المستخدم
    }
  } catch (e) {
    print('خطأ أثناء الموافقة على الخدمة: $e');
  }
}

// كشف الحساب البياني لمزود الخدمة
class AccountStatementSection extends StatefulWidget {
  final String providerId;
  const AccountStatementSection({super.key, required this.providerId});

  @override
  State<AccountStatementSection> createState() =>
      _AccountStatementSectionState();
}

class _AccountStatementSectionState extends State<AccountStatementSection> {
  bool showAll = false;

  Future<List<Map<String, dynamic>>> _fetchAllBookings() async {
    final bookingsSnapshot = await FirebaseFirestore.instance
        .collection('bookings')
        .where('providerId', isEqualTo: widget.providerId)
        .orderBy('createdAt', descending: true)
        .get();
    return bookingsSnapshot.docs.map((doc) {
      final data = doc.data();
      data['id'] = doc.id;
      return data;
    }).toList();
  }

  @override
  Widget build(BuildContext context) {
    return FutureBuilder<List<Map<String, dynamic>>>(
      future: _fetchAllBookings(),
      builder: (context, snapshot) {
        if (snapshot.hasError) {
          return Center(
            child: Text(
              'حدث خطأ أثناء تحميل الحجوزات. تأكد من وجود الحقل createdAt في كل حجز أو تحقق من اتصال الإنترنت.\n${snapshot.error}',
              style: const TextStyle(color: Colors.red, fontSize: 14),
              textAlign: TextAlign.center,
            ),
          );
        }
        if (!snapshot.hasData) {
          return const Center(child: CircularProgressIndicator());
        }
        final bookings = snapshot.data!;
        final approved = bookings
            .where((b) => b['status'] == 'approved')
            .toList();
        final rejected = bookings
            .where((b) => b['status'] == 'rejected')
            .toList();
        final total = bookings.length;

        if (!showAll) {
          return Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Card(
                child: Padding(
                  padding: const EdgeInsets.all(16.0),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.spaceAround,
                    children: [
                      _buildSummaryTile(
                        'إجمالي الحجوزات',
                        total,
                        Icons.list_alt,
                        const Color(0xFF530405),
                      ),
                      _buildSummaryTile(
                        'الموافق عليها',
                        approved.length,
                        Icons.check_circle,
                        Colors.green,
                      ),
                      _buildSummaryTile(
                        'المرفوضة',
                        rejected.length,
                        Icons.cancel,
                        Colors.red,
                      ),
                    ],
                  ),
                ),
              ),
              SizedBox(height: 12),
              SizedBox(height: 12),
              Center(
                child: ElevatedButton.icon(
                  icon: Icon(Icons.receipt_long),
                  label: Text('view_all_bookings'.tr()),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Color(0xFFB46A6A),
                    foregroundColor: Colors.white,
                  ),
                  onPressed: () => setState(() => showAll = true),
                ),
              ),
            ],
          );
        } else {
          if (bookings.isEmpty) {
            return Center(
              child: Text(
                'لا توجد حجوزات بعد.',
                style: TextStyle(color: Colors.grey[600], fontSize: 14),
              ),
            );
          }
          return Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text(
                    'جميع الحجوزات',
                    style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16),
                  ),
                  TextButton.icon(
                    icon: Icon(Icons.arrow_back),
                    label: Text('back'.tr()),
                    onPressed: () => setState(() => showAll = false),
                  ),
                ],
              ),
              Divider(),
              ListView.separated(
                shrinkWrap: true,
                physics: NeverScrollableScrollPhysics(),
                itemCount: bookings.length,
                separatorBuilder: (context, i) => Divider(),
                itemBuilder: (context, i) {
                  final booking = bookings[i];
                  final customerName = booking['customerName'] ?? 'غير محدد';
                  final details = booking['details'] ?? '';
                  final price = (booking['price'] ?? 0).toString();
                  final status = booking['status'] ?? '';
                  final createdAt = booking['createdAt'];
                  String dateStr = '';
                  if (createdAt is Timestamp) {
                    final dt = createdAt.toDate();
                    dateStr =
                        '${dt.year}/${dt.month.toString().padLeft(2, '0')}/${dt.day.toString().padLeft(2, '0')}';
                  }
                  return ListTile(
                    leading: Icon(
                      status == 'approved' ? Icons.check_circle : Icons.cancel,
                      color: status == 'approved' ? Colors.green : Colors.red,
                    ),
                    title: Text('الزبون: $customerName'),
                    subtitle: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        if (details.isNotEmpty) Text('تفاصيل: $details'),
                        if (dateStr.isNotEmpty) Text('تاريخ: $dateStr'),
                        Text(
                          'الحالة: ${status == 'approved' ? 'موافق عليه' : 'مرفوض'}',
                        ),
                      ],
                    ),
                    trailing: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text(
                          '$price د.ع',
                          style: TextStyle(
                            fontWeight: FontWeight.bold,
                            color: Colors.blue,
                          ),
                        ),
                        Text(
                          'السعر',
                          style: TextStyle(
                            fontSize: 11,
                            color: Colors.grey[600],
                          ),
                        ),
                      ],
                    ),
                  );
                },
              ),
            ],
          );
        }
      },
    );
  }

  Widget _buildSummaryTile(
    String label,
    int value,
    IconData icon,
    Color color,
  ) {
    return Column(
      children: [
        Icon(icon, color: color, size: 32),
        SizedBox(height: 4),
        Text(
          '$value',
          style: TextStyle(fontWeight: FontWeight.bold, fontSize: 18),
        ),
        Text(label, style: TextStyle(fontSize: 13, color: Colors.grey[700])),
      ],
    );
  }
}

